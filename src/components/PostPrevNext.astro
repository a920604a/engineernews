---
interface Post {
  id: string;
  title: string;
}

interface Props {
  prev?: Post;
  next?: Post;
  basePath?: string;
  prevLabel?: string;
  nextLabel?: string;
}

const { prev, next, basePath = '/posts', prevLabel = '← 上一篇', nextLabel = '下一篇 →' } = Astro.props;
---

<div class="prev-next-nav">
  <div class="nav-item">
    {prev && (
      <a href={`${basePath}/${prev.id}`} class="nav-link prev">
        <span class="nav-label">{prevLabel}</span>
        <span class="nav-title">{prev.title}</span>
      </a>
    )}
  </div>
  <div class="nav-item">
    {next && (
      <a href={`${basePath}/${next.id}`} class="nav-link next">
        <span class="nav-label">{nextLabel}</span>
        <span class="nav-title">{next.title}</span>
      </a>
    )}
  </div>
</div>

<style>
  .prev-next-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 0.5px solid var(--separator);
  }

  .nav-link {
    display: flex;
    flex-direction: column;
    padding: 14px 16px;
    background: var(--bg-secondary);
    border: 0.5px solid var(--separator);
    border-radius: var(--radius-md);
    text-decoration: none;
    height: 100%;
    min-width: 0;
    transition: all 0.2s ease;
  }

  .nav-link:hover {
    border-color: var(--accent);
    background: var(--glass);
    transform: translateY(-1px);
  }

  .nav-label {
    font-size: 10px;
    font-weight: 700;
    color: var(--label-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }

  .nav-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--label);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .next { text-align: right; }

  /* Tablet: 2 columns still, tighter spacing */
  @media (max-width: 768px) {
    .prev-next-nav { gap: 10px; margin-top: 40px; }
    .nav-link { padding: 12px 14px; }
    .nav-title { font-size: 13px; }
  }

  /* Mobile: single column, stacked */
  @media (max-width: 520px) {
    .prev-next-nav { grid-template-columns: 1fr; gap: 8px; }
    .next { text-align: left; }
  }
</style>

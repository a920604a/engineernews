---
import type { Lang } from '../i18n/ui';
import { getPostUrl } from '../lib/postPaths';
import { getSeriesHref } from '../utils/series';

interface Props {
  id: string;
  title: string;
  date: Date;
  category: string;
  tags: string[];
  description?: string;
  tldr?: string;
  type?: string;
  pinned?: boolean;
  readingTime?: number;
  lang?: Lang;
  github?: string;
  url?: string;
  featured?: boolean;
  series?: { name: string; order: number };
}

const {
  id, title, date, category, tags,
  description, tldr, type, pinned = false,
  readingTime, lang = 'zh-TW',
  github, url, featured = false, series,
} = Astro.props;

const isEn = lang === 'en';
const postHref = getPostUrl(id, lang);
const seriesHref = series ? getSeriesHref(series.name, lang) : undefined;
const catHref  = isEn ? `/en/categories/${category}` : `/categories/${category}`;
const tagHref  = (t: string) => isEn ? `/en/tags/${t}` : `/tags/${t}`;

const dateStr = date?.toLocaleDateString(isEn ? 'en-US' : 'zh-TW', {
  year: 'numeric', month: 'long', day: 'numeric',
}) ?? '';

const excerpt = tldr || description || '';

const typeLabels: Record<string, { zh: string; en: string }> = {
  'debug':       { zh: '除錯',    en: 'Debug' },
  'deep-dive':   { zh: '深度解析', en: 'Deep Dive' },
  'guide':       { zh: '指南',    en: 'Guide' },
  'how-to':      { zh: '操作教學', en: 'How-To' },
  'listicle':    { zh: '清單整理', en: 'Listicle' },
  'explainer':   { zh: '概念解析', en: 'Explainer' },
  'case-study':  { zh: '案例分析', en: 'Case Study' },
  'comparison':  { zh: '比較評測', en: 'Comparison' },
  'research':    { zh: '研究筆記', en: 'Research' },
  'newsjacking': { zh: '時事觀察', en: 'Newsjacking' },
};
const typeLabel = type ? (isEn ? (typeLabels[type]?.en ?? type) : (typeLabels[type]?.zh ?? type)) : undefined;
---

<article
  class={`card${pinned ? ' card--pinned' : ''}${featured ? ' card--featured' : ''}`}
  data-category={category}
  style={`--cat-color: var(--cat-${category}, var(--cat-default, var(--accent)));`}
>
  <div class="card-header">
    <div class="card-badges">
      {pinned && <span class="badge badge-pinned">置頂</span>}
      <a href={catHref} class="badge badge-cat badge-category" data-category={category}>{category}</a>
      {series && seriesHref && (
        <a href={seriesHref} class="badge badge-series" title={series.name}>📚 {series.name}</a>
      )}
    </div>
    <div class="card-meta">
      {typeLabel && <span class="card-type">{typeLabel}</span>}
      {date && <time class="card-date">{dateStr}</time>}
      {readingTime && <span class="card-rt">{readingTime} {isEn ? 'min' : '分鐘'}</span>}
    </div>
  </div>

  <h2 class="card-title">
    <a href={postHref}>{title}</a>
  </h2>

  {excerpt && <p class="card-excerpt">{excerpt}</p>}

  {tags.length > 0 && (
    <div class="card-tags">
      {tags.map((tag) => (
        <a href={tagHref(tag)} class="card-tag">#{tag}</a>
      ))}
    </div>
  )}

  {type === 'case-study' && (github || url) && (
    <div class="card-links">
      {github && (
        <a href={github} target="_blank" rel="noopener" class="card-link">
          GitHub ↗
        </a>
      )}
      {url && (
        <a href={url} target="_blank" rel="noopener" class="card-link">
          網站 ↗
        </a>
      )}
    </div>
  )}
</article>

<style>
  .card {
    background: var(--bg-secondary);
    border: 0.5px solid var(--separator);
    border-radius: var(--radius-lg);
    padding: 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
    cursor: pointer;
  }
  .card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--cat-color) 22%, var(--separator));
  }
  .card--pinned {
    border-color: #ff3b30;
    border-width: 1.5px;
  }
  .card--pinned:hover {
    border-color: #ff3b30;
  }

  .card--featured {
    padding: 30px 34px;
    border-width: 1px;
    border-color: color-mix(in srgb, var(--cat-color) 18%, var(--separator));
  }
  .card--featured.card--pinned {
    border-color: #ff3b30;
    border-width: 1.5px;
  }
  .card--featured .card-title {
    font-size: 29px;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }
  .card--featured .card-excerpt {
    font-size: 15px;
    -webkit-line-clamp: 3;
    line-height: 1.7;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .card-badges {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .card-type {
    font-size: 12px;
    color: var(--label-secondary);
    font-weight: 600;
    white-space: nowrap;
  }
  .card-type::after { content: '·'; margin-left: 6px; color: var(--label-tertiary); font-weight: 400; }

  .card-date {
    font-size: 12px;
    color: var(--label-tertiary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .card-rt {
    font-size: 12px;
    color: var(--label-tertiary);
    white-space: nowrap;
  }
  .card-rt::before { content: '· '; }

  /* Badges */
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-decoration: none;
    text-transform: uppercase;
    transition: opacity 0.15s;
  }
  .badge:hover { opacity: 0.75; }

  .badge-pinned {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    color: var(--accent);
    border: 0.5px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .badge-cat {
    background: color-mix(in srgb, var(--cat-color) 12%, transparent);
    color: var(--cat-color);
    border: 0.5px solid color-mix(in srgb, var(--cat-color) 30%, transparent);
  }
  .badge-series {
    background: var(--glass);
    color: var(--label-secondary);
    border: 0.5px solid var(--separator);
    text-transform: none;
    letter-spacing: 0;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Title */
  .card-title {
    font-size: 23px;
    font-weight: 800;
    letter-spacing: -0.022em;
    line-height: 1.28;
    margin: 2px 0;
  }
  .card-title a {
    color: var(--label);
    text-decoration: none;
    transition: color 0.15s;
  }
  .card-title a:hover { color: var(--accent); }
  .card:hover .card-title a { color: color-mix(in srgb, var(--cat-color) 88%, var(--label)); }

  /* Excerpt */
  .card-excerpt {
    font-size: 14px;
    color: var(--label-secondary);
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Tags */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }
  .card-tag {
    font-size: 12px;
    color: var(--label-tertiary);
    text-decoration: none;
    transition: color 0.15s;
  }
  .card-tag:hover { color: var(--accent); }

  /* Case-study links */
  .card-links {
    display: flex;
    gap: 8px;
    margin-top: 2px;
  }
  .card-link {
    font-size: 12px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    padding: 3px 10px;
    border: 0.5px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    transition: background 0.15s;
  }
  .card-link:hover {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }
</style>

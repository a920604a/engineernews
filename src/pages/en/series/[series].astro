---
export const prerender = true;
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { useTranslations } from '../../../i18n/utils';
import { getSeriesSummaries, type SeriesSummary } from '../../../utils/series';

const lang = 'en';
const t = useTranslations(lang);

export async function getStaticPaths() {
  const seriesList = await getSeriesSummaries('en');
  return seriesList.map(series => ({
    params: { series: series.slug },
    props: { series },
  }));
}

const { series } = Astro.props as { series: SeriesSummary };
---
<BaseLayout title={series.name} description={series.description}>
  <section class="series-detail">
    <a href="/en/series" class="back-link">← {t('series.title')}</a>

    <header class="series-hero">
      <p class="eyebrow">Series · {series.count} {t('series.posts')}</p>
      <h1>{series.name}</h1>
      <p class="hero-sub">{series.description}</p>
    </header>

    <ol class="series-list">
      {series.posts.map((post, i) => (
        <li>
          <span class="series-order">{String(i + 1).padStart(2, '0')}</span>
          <div class="series-item-card">
            <PostCard
              id={post.id}
              title={post.data.title}
              date={post.data.date}
              category={post.data.category}
              tags={post.data.tags}
              description={post.data.description}
              tldr={post.data.tldr}
              readingTime={post.data.readingTime}
              lang={lang}
              type={post.data.type}
            />
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style>
  .series-detail { padding-top: 32px; }

  .back-link {
    display: inline-block;
    font-size: 13px; color: var(--label-tertiary);
    text-decoration: none; margin-bottom: 20px;
  }
  .back-link:hover { color: var(--accent); }

  .series-hero {
    position: relative;
    padding: 22px 0 26px 18px;
    margin-bottom: 28px;
  }
  .series-hero::before {
    content: ''; position: absolute; left: 0; top: 4px; bottom: 4px;
    width: 4px; border-radius: var(--radius-full);
    background: linear-gradient(180deg, var(--accent), var(--heading-accent));
  }
  .eyebrow {
    color: var(--heading-accent);
    font-size: 11px; font-weight: 800;
    letter-spacing: 0.08em; text-transform: uppercase;
    margin: 0 0 10px;
  }
  .series-hero h1 {
    font-size: clamp(28px, 6vw, 42px);
    line-height: 1.15; margin: 0 0 12px;
    letter-spacing: -0.02em;
  }
  .hero-sub { margin: 0; color: var(--label-secondary); font-size: 15px; line-height: 1.7; max-width: 64ch; }

  .series-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .series-list li {
    position: relative;
    display: grid; grid-template-columns: 40px 1fr; gap: 14px; align-items: start;
  }
  .series-list li:not(:last-child)::before {
    content: ''; position: absolute;
    left: 19px; top: 38px; bottom: -16px;
    width: 2px; background: var(--separator);
  }
  .series-order {
    z-index: 1;
    display: flex; align-items: center; justify-content: center;
    width: 38px; height: 38px; margin-top: 6px;
    border-radius: 50%;
    background: var(--bg-secondary);
    border: 1.5px solid color-mix(in srgb, var(--accent) 40%, var(--separator));
    color: var(--accent);
    font-size: 13px; font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .series-item-card { min-width: 0; }

  @media (max-width: 560px) {
    .series-list li { grid-template-columns: 30px 1fr; gap: 10px; }
    .series-list li:not(:last-child)::before { left: 14px; }
    .series-order { width: 30px; height: 30px; font-size: 11px; }
  }
</style>

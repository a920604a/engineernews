---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';

export const prerender = true;

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.lang === 'en');
  const categories = [...new Set(allPosts.map((p) => p.data.category))];

  return categories.map((category) => {
    const posts = allPosts
      .filter((p) => p.data.category === category)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    return { params: { category }, props: { posts } };
  });
}

const { category } = Astro.params;
const { posts } = Astro.props;

const types = [...new Set(posts.flatMap((p) => p.data.type ? [p.data.type] : []))];
const typeLabels: Record<string, string> = {
  'debug': 'Debug',
  'deep-dive': 'Deep Dive',
  'guide': 'Guide',
  'how-to': 'How-To',
  'listicle': 'Listicle',
  'explainer': 'Explainer',
  'case-study': 'Case Study',
  'comparison': 'Comparison',
  'research': 'Research',
  'newsjacking': 'Newsjacking',
};

const topicMeta: Record<string, string> = {
  tech: 'Engineering practice, architecture, tooling, and debugging notes.',
  product: 'Product design, UX, strategy, and side project thinking.',
  learning: 'AI, courses, knowledge work, and conceptual breakdowns.',
  creative: 'Film, design, travel, coffee, and creative references.',
  career: 'Career decisions, collaboration, work style, and reflection.',
  life: 'Personal notes and low-frequency observations.',
};
const featured = posts.find(p => p.data.pinned) ?? null;
const rest = featured ? posts.filter(p => p.id !== featured.id) : posts;

function calcReadingTime(post: (typeof posts)[0]): number {
  if (post.data.readingTime) return post.data.readingTime;
  const body = post.body ?? '';
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
}
---

<BaseLayout title={`Category: ${category}`}>
  <section class="topic-page" style={`--cat-color: var(--cat-${category}, var(--cat-default, var(--accent)));`}>
    <a href="/en/categories" class="back-link">
      ← All Categories
    </a>
    <div class="topic-hero">
      <span class="badge badge-category" data-category={category}>{category}</span>
      <h1>{category}</h1>
      <p>{topicMeta[category] ?? 'Related posts and notes.'}</p>
      <span class="topic-stat">{posts.length} posts</span>
    </div>

    <div class="controls-row">
      {types.length > 0 && (
        <div class="control-group" id="type-filters">
          <span class="control-label">Type</span>
          <button class="type-btn active" data-type="all">All</button>
          {types.map((type) => (
            <button class="type-btn" data-type={type}>
              {typeLabels[type] ?? type}
            </button>
          ))}
        </div>
      )}

      <div class="control-group" id="sort-controls">
        <span class="control-label">Sort</span>
        <button class="sort-btn active" data-sort="date-desc">Date ↓</button>
        <button class="sort-btn" data-sort="date-asc">Date ↑</button>
        <button class="sort-btn" data-sort="reading-time">Reading time</button>
        <button class="sort-btn" data-sort="tags">Tags A→Z</button>
        <button class="sort-btn" data-sort="views" id="sort-views-btn">Views</button>
      </div>
    </div>

    {featured && (
      <section class="featured">
        <p class="section-label">Featured</p>
        <PostCard
          id={featured.id}
          title={featured.data.title}
          date={featured.data.date}
          category={featured.data.category}
          tags={featured.data.tags}
          description={featured.data.description}
          tldr={featured.data.tldr}
          type={featured.data.type}
          readingTime={featured.data.readingTime}
          lang="en"
          featured={true}
        />
      </section>
    )}

    <div class="feed" id="posts-feed">
      {rest.map((post) => (
        <div
          data-type={post.data.type ?? 'none'}
          data-date={post.data.date.valueOf()}
          data-reading-time={calcReadingTime(post)}
          data-tags={post.data.tags?.[0] ?? ''}
          data-slug={post.id}
          data-views="0"
          class="post-item"
        >
          <PostCard
            id={post.id}
            title={post.data.title}
            date={post.data.date}
            category={post.data.category}
            tags={post.data.tags}
            description={post.data.description}
            tldr={post.data.tldr}
            type={post.data.type}
            readingTime={post.data.readingTime}
            lang="en"
          />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .topic-page { padding-top: 32px; }
  .back-link {
    font-size: 13px;
    color: var(--label-secondary);
    text-decoration: none;
    margin-bottom: 18px;
    display: inline-block;
  }
  .back-link:hover { color: var(--cat-color); }
  .topic-hero {
    padding: 24px 0 28px;
    border-bottom: 0.5px solid color-mix(in srgb, var(--cat-color) 28%, var(--separator));
    margin-bottom: 24px;
  }
  .topic-hero h1 {
    margin: 12px 0 10px;
    font-size: clamp(32px, 7vw, 52px);
  }
  .topic-hero p {
    max-width: 660px;
    margin: 0;
    color: var(--label-secondary);
    line-height: 1.75;
  }
  .topic-stat {
    display: inline-flex;
    margin-top: 16px;
    color: var(--cat-color);
    font-size: 13px;
    font-weight: 800;
  }
  .featured { margin-bottom: 24px; }
  .section-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--label-tertiary);
    margin: 0 0 10px;
  }
  .feed {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .controls-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
  }
  .control-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .control-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--label-tertiary);
    min-width: 32px;
  }
  .type-btn, .sort-btn {
    padding: 5px 14px;
    border-radius: 999px;
    border: 0.5px solid var(--separator);
    background: transparent;
    color: var(--label-secondary);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }
  .type-btn:hover, .type-btn.active {
    background: var(--cat-color);
    border-color: var(--cat-color);
    color: #fff;
  }
  .sort-btn:hover, .sort-btn.active {
    background: var(--bg-tertiary, var(--bg-secondary));
    border-color: var(--label-secondary);
    color: var(--label);
  }
  .sort-btn[data-sort="views"].loading {
    opacity: 0.5;
    cursor: wait;
  }
</style>

<script>
  function filterPosts(type: string) {
    document.querySelectorAll<HTMLElement>('.post-item').forEach((item) => {
      item.style.display = (type === 'all' || item.dataset.type === type) ? '' : 'none';
    });
    document.querySelectorAll<HTMLElement>('.type-btn').forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.type === type);
    });
  }

  function sortPosts(key: string) {
    document.querySelectorAll<HTMLElement>('.sort-btn').forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.sort === key);
    });
    const feed = document.getElementById('posts-feed');
    if (!feed) return;
    const items = Array.from(feed.querySelectorAll<HTMLElement>('.post-item'));
    items.sort((a, b) => {
      switch (key) {
        case 'date-asc':  return Number(a.dataset.date) - Number(b.dataset.date);
        case 'date-desc': return Number(b.dataset.date) - Number(a.dataset.date);
        case 'reading-time': return Number(a.dataset.readingTime) - Number(b.dataset.readingTime);
        case 'tags': return (a.dataset.tags ?? '').localeCompare(b.dataset.tags ?? '', 'en');
        case 'views': return Number(b.dataset.views) - Number(a.dataset.views);
        default: return 0;
      }
    });
    items.forEach((item) => feed.appendChild(item));
  }

  document.querySelectorAll<HTMLElement>('.type-btn').forEach((btn) => {
    btn.addEventListener('click', () => filterPosts(btn.dataset.type!));
  });

  let viewsLoaded = false;

  async function loadViews() {
    const btn = document.getElementById('sort-views-btn');
    if (btn) btn.classList.add('loading');
    const items = document.querySelectorAll<HTMLElement>('.post-item[data-slug]');
    await Promise.all(Array.from(items).map(async (item) => {
      const slug = item.dataset.slug;
      if (!slug) return;
      try {
        const res = await fetch(`/api/views?slug=${encodeURIComponent(slug)}`);
        const { count } = await res.json();
        item.dataset.views = String(count ?? 0);
      } catch {}
    }));
    viewsLoaded = true;
    if (btn) btn.classList.remove('loading');
  }

  document.querySelectorAll<HTMLElement>('.sort-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.sort!;
      if (key === 'views' && !viewsLoaded) {
        loadViews().then(() => sortPosts(key));
      } else {
        sortPosts(key);
      }
    });
  });

  const params = new URLSearchParams(window.location.search);
  const t = params.get('type');
  if (t) filterPosts(t);
</script>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts', ({ data }) =>
  !data.draft && data.type === 'case-study' && data.lang === 'zh-TW'
);
const sorted = posts.sort((a, b) => {
  if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});

const allTags = [...new Set(sorted.flatMap(p => p.data.tags))];
---

<BaseLayout title="作品集">
  <section class="projects-page">
    <div class="projects-hero">
      <p class="eyebrow">Portfolio</p>
      <h1>作品集</h1>
      <p class="hero-desc">Side projects 與個人工程作品。從架構選型到實際上線的完整紀錄。</p>
      <p class="hero-stat">{sorted.length} 個專案</p>
    </div>

    {sorted.length === 0 ? (
      <div class="empty">目前沒有公開作品，稍後再來。</div>
    ) : (
      <div class="project-grid">
        {sorted.map((post) => {
          const dateStr = post.data.date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long' });
          return (
            <article class="project-card" data-category={post.data.category}>
              <div class="project-card-inner">
                <div class="project-header">
                  <div class="project-badges">
                    <span class="badge badge-category" data-category={post.data.category}>{post.data.category}</span>
                    {post.data.pinned && <span class="badge badge-pinned">精選</span>}
                  </div>
                  <time class="project-date">{dateStr}</time>
                </div>

                <h2 class="project-title">
                  <a href={`/posts/${post.id}`}>{post.data.title}</a>
                </h2>

                {(post.data.tldr || post.data.description) && (
                  <p class="project-desc">{post.data.tldr ?? post.data.description}</p>
                )}

                <div class="project-tags">
                  {post.data.tags.map(tag => (
                    <a href={`/tags/${tag}`} class="project-tag">#{tag}</a>
                  ))}
                </div>
              </div>

              <div class="project-footer">
                <a href={`/posts/${post.id}`} class="project-link link-read">
                  閱讀案例 →
                </a>
                <div class="project-ext-links">
                  {post.data.github && (
                    <a href={post.data.github} target="_blank" rel="noopener" class="project-link link-ext">
                      GitHub ↗
                    </a>
                  )}
                  {post.data.url && (
                    <a href={post.data.url} target="_blank" rel="noopener" class="project-link link-ext">
                      網站 ↗
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .projects-page {
    padding-top: 44px;
  }

  .projects-hero {
    padding-bottom: 32px;
    border-bottom: 0.5px solid var(--separator);
    margin-bottom: 32px;
  }

  .eyebrow {
    color: var(--heading-accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 10px;
  }

  .projects-hero h1 {
    font-size: clamp(32px, 7vw, 52px);
    margin: 0 0 12px;
    line-height: 1.1;
  }

  .hero-desc {
    max-width: 600px;
    color: var(--label-secondary);
    line-height: 1.75;
    margin: 0 0 14px;
    font-size: 16px;
  }

  .hero-stat {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }

  .project-card {
    background: var(--bg-secondary);
    border: 0.5px solid var(--separator);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
  }

  .project-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 20%, var(--separator));
  }

  .project-card-inner {
    flex: 1;
    padding: 22px 24px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .project-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .project-badges {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .badge-category {
    background: color-mix(in srgb, var(--cat-color, var(--accent)) 12%, transparent);
    color: var(--cat-color, var(--accent));
    border: 0.5px solid color-mix(in srgb, var(--cat-color, var(--accent)) 30%, transparent);
  }

  .badge-pinned {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    border: 0.5px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .project-date {
    font-size: 12px;
    color: var(--label-tertiary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .project-title {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .project-title a {
    color: var(--label);
    text-decoration: none;
    transition: color 0.15s;
  }

  .project-title a:hover,
  .project-card:hover .project-title a {
    color: var(--accent);
  }

  .project-desc {
    font-size: 14px;
    color: var(--label-secondary);
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: auto;
  }

  .project-tag {
    font-size: 12px;
    color: var(--label-tertiary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .project-tag:hover { color: var(--accent); }

  .project-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 12px 24px;
    border-top: 0.5px solid var(--separator);
    background: color-mix(in srgb, var(--bg-secondary) 60%, var(--bg));
  }

  .project-link {
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }

  .link-read {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 0.5px solid color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .link-read:hover {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .project-ext-links {
    display: flex;
    gap: 6px;
  }

  .link-ext {
    color: var(--label-secondary);
    background: var(--bg);
    border: 0.5px solid var(--separator);
  }

  .link-ext:hover {
    color: var(--label);
    border-color: color-mix(in srgb, var(--label) 30%, var(--separator));
  }

  .empty {
    text-align: center;
    padding: 72px 24px;
    color: var(--label-secondary);
    border: 0.5px dashed var(--separator);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => data.draft === true && data.lang === 'zh-TW');
const drafts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const CATEGORIES = ['tech', 'product', 'learning', 'career', 'life', 'creative'];
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Review Drafts</title>
  <script>
    (function () {
      var t = localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    /* ── Site themes (mirrors BaseLayout) ── */
    :root {
      --bg: #000000; --bg-secondary: #1c1c1e; --bg-tertiary: #2c2c2e;
      --label: #ffffff; --label-secondary: rgba(235,235,245,0.6); --label-tertiary: rgba(235,235,245,0.3);
      --separator: rgba(84,84,88,0.65); --accent: #0a84ff; --color-green: #30d158;
      --card-bg: rgba(28,28,30,0.8); --glass: rgba(255,255,255,0.06); --shadow-md: 0 4px 20px rgba(0,0,0,0.6);
    }
    :root[data-theme="light"] {
      --bg: #f5f5f7; --bg-secondary: #ffffff; --bg-tertiary: #e5e5ea;
      --label: #1d1d1f; --label-secondary: rgba(60,60,67,0.6); --label-tertiary: rgba(60,60,67,0.3);
      --separator: rgba(60,60,67,0.18); --accent: #007aff; --color-green: #34c759;
      --card-bg: rgba(255,255,255,0.9); --glass: rgba(0,0,0,0.04);
      --shadow-md: 0 2px 16px rgba(0,0,0,0.08), 0 1px 3px rgba(0,0,0,0.06);
    }
    :root[data-theme="warm"] {
      --bg: #f7f3ea; --bg-secondary: #fffaf0; --bg-tertiary: #eee6d6;
      --label: #24201a; --label-secondary: rgba(51,43,34,0.68); --label-tertiary: rgba(51,43,34,0.42);
      --separator: rgba(92,76,57,0.18); --accent: #2563eb; --color-green: #15803d;
      --card-bg: rgba(255,250,240,0.92); --glass: rgba(92,76,57,0.055);
      --shadow-md: 0 2px 18px rgba(92,76,57,0.1), 0 1px 3px rgba(92,76,57,0.08);
    }
    :root[data-theme="nord"] {
      --bg: #2e3440; --bg-secondary: #3b4252; --bg-tertiary: #434c5e;
      --label: #eceff4; --label-secondary: rgba(216,222,233,0.75); --label-tertiary: rgba(216,222,233,0.4);
      --separator: rgba(76,86,106,0.8); --accent: #88c0d0; --color-green: #a3be8c;
      --card-bg: rgba(59,66,82,0.85); --glass: rgba(236,239,244,0.05); --shadow-md: 0 4px 20px rgba(0,0,0,0.4);
    }
    :root[data-theme="catppuccin"] {
      --bg: #1e1e2e; --bg-secondary: #313244; --bg-tertiary: #45475a;
      --label: #cdd6f4; --label-secondary: rgba(186,194,222,0.75); --label-tertiary: rgba(186,194,222,0.4);
      --separator: rgba(69,71,90,0.9); --accent: #89b4fa; --color-green: #a6e3a1;
      --card-bg: rgba(49,50,68,0.85); --glass: rgba(205,214,244,0.05); --shadow-md: 0 4px 20px rgba(0,0,0,0.5);
    }
    :root[data-theme="tokyo"] {
      --bg: #1a1b2e; --bg-secondary: #24253a; --bg-tertiary: #2d2f45;
      --label: #c0caf5; --label-secondary: rgba(154,165,206,0.8); --label-tertiary: rgba(154,165,206,0.4);
      --separator: rgba(65,72,104,0.8); --accent: #7aa2f7; --color-green: #9ece6a;
      --card-bg: rgba(36,37,58,0.88); --glass: rgba(192,202,245,0.05); --shadow-md: 0 4px 20px rgba(0,0,0,0.55);
    }
    @media (prefers-color-scheme: light) {
      :root:not([data-theme]) {
        --bg: #f5f5f7; --bg-secondary: #ffffff; --bg-tertiary: #e5e5ea;
        --label: #1d1d1f; --label-secondary: rgba(60,60,67,0.6); --label-tertiary: rgba(60,60,67,0.3);
        --separator: rgba(60,60,67,0.18); --accent: #007aff; --color-green: #34c759;
        --card-bg: rgba(255,255,255,0.9); --glass: rgba(0,0,0,0.04);
        --shadow-md: 0 2px 16px rgba(0,0,0,0.08), 0 1px 3px rgba(0,0,0,0.06);
      }
    }
    /* ── Local aliases ── */
    :root {
      --surface: var(--bg-secondary);
      --surface-subtle: var(--bg-tertiary);
      --surface-strong: var(--glass);
      --text: var(--label);
      --muted: var(--label-secondary);
      --faint: var(--label-tertiary);
      --line: var(--separator);
      --line-soft: color-mix(in srgb, var(--separator) 60%, transparent);
      --accent-soft: color-mix(in srgb, var(--accent) 10%, transparent);
      --shadow: var(--shadow-md);
      --green: var(--color-green);
      --green-soft: color-mix(in srgb, var(--color-green) 10%, transparent);
      --red: #c2410c;
      --red-soft: #fff4ed;
      --focus-bg: #0b1020;
      --focus-shell: #111827;
      --focus-panel: #162033;
      --focus-panel-soft: #1e293b;
      --focus-line: rgba(148, 163, 184, 0.22);
      --focus-text: #e5e7eb;
      --focus-muted: #94a3b8;
      --focus-accent: #60a5fa;
      --focus-green: #22c55e;
      --focus-warn: #fbbf24;
      --mono: 'SF Mono', 'Fira Code', ui-monospace, Menlo, Consolas, monospace;
      --sans: 'Noto Sans TC', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }
    html { background: var(--bg); }
    body {
      font-family: var(--sans);
      margin: 0;
      background:
        radial-gradient(circle at 18% -10%, color-mix(in srgb, var(--accent) 8%, transparent), transparent 34%),
        var(--bg);
      color: var(--text);
      min-height: 100vh;
    }
    h1 { font-size: clamp(24px, 4vw, 34px); font-weight: 850; letter-spacing: 0; line-height: 1.12; margin: 0; }
    button, input, select, textarea { font: inherit; }

    /* ── Site nav (mirrors BaseLayout) ── */
    .site-header {
      position: sticky; top: 0; z-index: 100;
      background: var(--card-bg);
      backdrop-filter: saturate(180%) blur(24px);
      -webkit-backdrop-filter: saturate(180%) blur(24px);
      border-bottom: 0.5px solid var(--separator);
      margin-bottom: 0;
    }
    .nav-inner {
      max-width: 1180px; margin: 0 auto; padding: 0 20px;
      height: 48px; display: flex; align-items: center;
      justify-content: space-between; gap: 16px;
    }
    .nav-brand { font-size: 15px; font-weight: 600; color: var(--label); text-decoration: none; letter-spacing: -0.01em; white-space: nowrap; }
    .nav-links { display: flex; align-items: center; gap: 4px; flex: 1; }
    .nav-link { font-size: 14px; color: var(--label-secondary); text-decoration: none; padding: 5px 10px; border-radius: 8px; transition: color 0.15s, background 0.15s; white-space: nowrap; }
    .nav-link:hover { color: var(--label); background: var(--glass); }
    .nav-badge { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 9999px; background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); border: 0.5px solid color-mix(in srgb, var(--accent) 25%, transparent); }
    .theme-picker { position: relative; }
    .theme-btn { display: flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 9999px; border: 0.5px solid var(--separator); background: transparent; color: var(--label-secondary); font-size: 12px; font-weight: 500; cursor: pointer; transition: background 0.15s, color 0.15s; white-space: nowrap; }
    .theme-btn:hover { background: var(--glass); color: var(--label); }
    .theme-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); flex-shrink: 0; }
    .theme-menu { display: none; position: absolute; right: 0; top: calc(100% + 6px); background: var(--bg-secondary); border: 0.5px solid var(--separator); border-radius: 12px; padding: 6px; min-width: 160px; box-shadow: var(--shadow-md); z-index: 200; }
    .theme-menu.open { display: block; }
    .theme-option { display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px 12px; border-radius: 8px; background: transparent; border: none; cursor: pointer; font-size: 13px; font-weight: 500; color: var(--label-secondary); text-align: left; transition: background 0.12s, color 0.12s; }
    .theme-option:hover { background: var(--glass); color: var(--label); }
    .theme-option.active { color: var(--label); }
    .theme-swatch { width: 14px; height: 14px; border-radius: 50%; flex-shrink: 0; border: 1.5px solid var(--separator); }

    .site-footer { text-align: center; padding: 32px 20px; color: var(--label-tertiary); font-size: 13px; border-top: 0.5px solid var(--separator); margin-top: 60px; }

    .page-content { max-width: 1180px; margin: 0 auto; padding: 28px 20px 64px; }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 20px;
      margin-bottom: 24px;
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--card-bg);
      backdrop-filter: blur(18px);
      box-shadow: var(--shadow);
    }
    .eyebrow {
      margin: 0 0 8px;
      color: var(--accent);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .meta { font-size: 14px; color: var(--muted); margin: 10px 0 0; }
    .top-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; justify-content: flex-end; }
    .count-badge {
      display: inline-flex;
      align-items: center;
      height: 34px;
      padding: 0 12px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--surface);
      color: var(--muted);
      font-size: 13px;
      font-weight: 700;
      white-space: nowrap;
    }
    #draft-list { display: flex; flex-direction: column; gap: 14px; }
    .card {
      background: var(--surface);
      border: 1px solid var(--line-soft);
      border-radius: 8px;
      padding: 18px;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
      transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    }
    .card:hover { border-color: var(--line); box-shadow: var(--shadow); transform: translateY(-1px); }
    .card-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: flex-start; gap: 18px; }
    .card-body { flex: 1; min-width: 0; }
    .card-title { font-size: 18px; font-weight: 800; line-height: 1.42; margin: 0 0 8px; letter-spacing: 0; }
    .card-tldr { font-size: 14px; line-height: 1.65; color: var(--muted); margin: 0 0 12px; max-width: 74ch; }
    .card-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 12px; }
    .tag {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      font-size: 12px;
      font-weight: 700;
      background: var(--surface-subtle);
      border: 1px solid var(--line-soft);
      border-radius: 999px;
      padding: 2px 9px;
      color: var(--muted);
    }
    .tag-cat { background: var(--accent-soft); border-color: #bfdbfe; color: #1d4ed8; }
    .tag-cat[data-category="tech"] { background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8; }
    .tag-cat[data-category="product"] { background: #f5f3ff; border-color: #ddd6fe; color: #6d28d9; }
    .tag-cat[data-category="learning"] { background: #fffbeb; border-color: #fde68a; color: #b45309; }
    .tag-cat[data-category="career"] { background: #ecfdf3; border-color: #bbf7d0; color: #15803d; }
    .tag-cat[data-category="life"] { background: #f0fdfa; border-color: #99f6e4; color: #0f766e; }
    .tag-cat[data-category="creative"] { background: #fff1f2; border-color: #fecdd3; color: #be123c; }
    .card-links { font-size: 13px; }
    .card-links a { color: var(--accent); text-decoration: none; font-weight: 700; }
    .card-links a:hover { text-decoration: underline; }
    .card-date {
      display: inline-flex;
      align-items: center;
      height: 28px;
      padding: 0 10px;
      border-radius: 999px;
      background: var(--surface-subtle);
      color: var(--muted);
      font-family: var(--mono);
      font-size: 12px;
      border: 1px solid var(--line-soft);
    }
    .card-actions { display: grid; grid-template-columns: repeat(3, auto); align-items: center; justify-content: end; gap: 8px; flex-shrink: 0; }
    .card-actions .card-date { grid-column: 1 / -1; justify-self: end; }
    .btn {
      border: 1px solid transparent;
      border-radius: 8px;
      padding: 8px 13px;
      font-size: 13px;
      font-weight: 750;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s, color 0.15s, box-shadow 0.15s;
      white-space: nowrap;
    }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-edit { background: var(--surface); color: var(--muted); border-color: var(--line); }
    .btn-edit:hover { background: var(--surface-subtle); border-color: var(--line); }
    .btn-edit.active { background: var(--accent-soft); border-color: #bfdbfe; color: #1d4ed8; }
    .btn-publish { background: var(--accent); color: #fff; box-shadow: 0 8px 18px rgba(37,99,235,0.18); }
    .btn-publish:hover:not(:disabled) { background: #1d4ed8; }
    .btn-save { background: var(--green); color: #fff; box-shadow: 0 8px 18px rgba(21,128,61,0.14); }
    .btn-save:hover:not(:disabled) { background: #166534; }
    .edit-panel { display: none; border-top: 1px solid var(--line-soft); margin-top: 18px; padding-top: 18px; }
    .edit-panel.open { display: block; }
    .edit-loading { color: var(--muted); font-size: 13px; padding: 12px 0; }
    .edit-form { display: none; }
    .edit-form.ready { display: block; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
    .form-row.full { grid-template-columns: 1fr; }
    .form-group { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
    .form-group label { font-size: 12px; font-weight: 800; color: var(--muted); letter-spacing: 0; }
    .form-group input, .form-group select, .form-group textarea {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 10px 12px;
      font-size: 14px;
      font-family: inherit;
      background: var(--surface);
      color: var(--text);
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent); }
    .form-group textarea { resize: vertical; font-family: var(--mono); font-size: 13px; line-height: 1.7; tab-size: 2; }
    .edit-footer {
      display: flex;
      gap: 10px;
      justify-content: flex-end;
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid var(--line-soft);
    }
    .toast-container { position: fixed; bottom: 24px; right: 24px; display: flex; flex-direction: column; gap: 8px; z-index: 100; }
    .toast { background: #111827; color: #fff; border-radius: 8px; padding: 12px 16px; font-size: 13px; max-width: 380px; animation: slide-in 0.2s ease; box-shadow: var(--shadow); }
    .toast.success { background: #166534; }
    .toast.error { background: #b42318; }
    .toast a { color: #a8d8ff; text-decoration: none; }
    @keyframes slide-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    .empty {
      text-align: center;
      padding: 72px 24px;
      color: var(--muted);
      background: var(--surface);
      border: 1px dashed var(--line);
      border-radius: 8px;
      font-weight: 700;
    }
    .btn-delete { background: var(--red-soft); border-color: #fed7aa; color: var(--red); }
    .btn-delete:hover:not(:disabled) { background: #ffedd5; }
    .editor-split { grid-template-columns: 1fr 1fr !important; }
    .editor-split textarea { height: 520px; min-height: 260px; background: #0f172a; color: #e5eefb; border-color: #172033; }
    .editor-split textarea:focus { box-shadow: 0 0 0 3px rgba(15,23,42,0.12); border-color: #334155; }
    .preview-pane {
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 18px 20px;
      height: 520px;
      overflow-y: auto;
      font-size: 14px;
      line-height: 1.75;
      background: var(--surface);
      color: var(--text);
    }
    .preview-pane h1,.preview-pane h2,.preview-pane h3 { font-weight: 800; line-height: 1.3; margin: 1em 0 0.45em; color: var(--text); }
    .preview-pane h1 { font-size: 1.4em; } .preview-pane h2 { font-size: 1.2em; } .preview-pane h3 { font-size: 1.05em; }
    .preview-pane p { margin: 0 0 0.7em; }
    .preview-pane code { background: var(--surface-subtle); border-radius: 5px; padding: 1px 5px; font-family: var(--mono); font-size: 0.9em; }
    .preview-pane pre { background: #0f172a; color: #e5eefb; border-radius: 8px; padding: 14px; overflow-x: auto; margin-bottom: 0.8em; }
    .preview-pane pre code { background: none; padding: 0; }
    .preview-pane ul,.preview-pane ol { padding-left: 1.5em; margin-bottom: 0.7em; }
    .preview-pane blockquote { border-left: 3px solid var(--line); padding-left: 1em; color: var(--muted); margin: 0 0 0.7em; }
    .preview-pane a { color: var(--accent); } .preview-pane hr { border: none; border-top: 1px solid var(--line-soft); margin: 1em 0; }
    .preview-pane img { max-width: 100%; }

    /* ── Fullscreen overlay ── */
    #fs-overlay { display: none; position: fixed; inset: 0; z-index: 1000; background: var(--focus-bg); flex-direction: column; color: var(--focus-text); }
    #fs-overlay.open { display: flex; }
    .fs-header { display: flex; align-items: center; gap: 14px; padding: 12px 18px; border-bottom: 1px solid var(--focus-line); background: rgba(17,24,39,0.96); flex-shrink: 0; box-shadow: 0 12px 32px rgba(0,0,0,0.2); }
    .fs-titlebar { display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0; }
    .fs-titlebar .form-group { flex: 1; min-width: 180px; }
    .fs-header .form-group label { color: var(--focus-muted) !important; }
    .fs-header input[name=title] {
      flex: 1;
      font-size: 15px;
      font-weight: 750;
      background: var(--focus-panel);
      border-color: var(--focus-line);
      color: var(--focus-text);
    }
    .fs-header input[name=title]:focus { border-color: var(--focus-accent); box-shadow: 0 0 0 3px rgba(96,165,250,0.18); }
    .fs-status {
      display: inline-flex;
      align-items: center;
      min-width: 86px;
      justify-content: center;
      height: 30px;
      border-radius: 999px;
      border: 1px solid var(--focus-line);
      background: var(--focus-panel);
      color: var(--focus-muted);
      font-size: 12px;
      font-weight: 800;
      white-space: nowrap;
    }
    .fs-status.dirty { background: rgba(251,191,36,0.14); border-color: rgba(251,191,36,0.38); color: var(--focus-warn); }
    .fs-status.saving { background: rgba(96,165,250,0.14); border-color: rgba(96,165,250,0.42); color: var(--focus-accent); }
    .fs-status.saved { background: rgba(34,197,94,0.14); border-color: rgba(34,197,94,0.36); color: var(--focus-green); }
    .fs-meta-toggle {
      background: var(--focus-panel);
      border: 1px solid var(--focus-line);
      border-radius: 8px;
      color: var(--focus-muted);
      cursor: pointer;
      font-size: 13px;
      font-weight: 800;
      padding: 7px 11px;
    }
    .fs-meta-toggle:hover { background: var(--focus-panel-soft); color: var(--focus-text); }
    .btn-fs-close { background: var(--focus-panel); border: 1px solid var(--focus-line); border-radius: 8px; font-size: 16px; cursor: pointer; color: var(--focus-muted); padding: 4px 12px; line-height: 1.6; }
    .btn-fs-close:hover { background: var(--focus-panel-soft); color: var(--focus-text); }
    .fs-meta { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 12px; padding: 12px 18px; border-bottom: 1px solid var(--focus-line); background: var(--focus-shell); flex-shrink: 0; }
    .fs-meta.collapsed { display: none; }
    .fs-meta .form-group label { color: var(--focus-muted); }
    .fs-meta input, .fs-meta select {
      background: var(--focus-panel);
      border-color: var(--focus-line);
      color: var(--focus-text);
    }
    .fs-meta input:focus, .fs-meta select:focus { border-color: var(--focus-accent); box-shadow: 0 0 0 3px rgba(96,165,250,0.18); }
    .fs-tabs { display: none; background: var(--focus-shell); border-bottom: 1px solid var(--focus-line); padding: 8px 12px; gap: 8px; }
    .fs-tab {
      flex: 1;
      border: 1px solid var(--focus-line);
      background: var(--focus-panel);
      color: var(--focus-muted);
      border-radius: 8px;
      padding: 8px 10px;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
    }
    .fs-tab.active { background: rgba(96,165,250,0.16); border-color: rgba(96,165,250,0.42); color: #bfdbfe; }
    .fs-editor { display: grid; grid-template-columns: minmax(420px, 0.98fr) minmax(420px, 1.02fr); flex: 1; min-height: 0; background: var(--focus-bg); }
    .fs-editor textarea {
      border: none;
      border-right: 1px solid var(--focus-line);
      resize: none;
      padding: 26px 28px;
      font-family: var(--mono);
      font-size: 14px;
      line-height: 1.82;
      outline: none;
      height: 100%;
      background: #0b1220;
      color: #dbeafe;
      caret-color: #93c5fd;
    }
    .fs-preview {
      padding: 30px 38px;
      overflow-y: auto;
      font-size: 16px;
      line-height: 1.82;
      background: #f8fafc;
      color: #1f2937;
      border-left: 1px solid rgba(255,255,255,0.05);
    }
    .fs-preview h1,.fs-preview h2,.fs-preview h3 { font-weight: 800; line-height: 1.28; margin: 1em 0 0.4em; color: #111827; }
    .fs-preview h1 { font-size: 1.4em; } .fs-preview h2 { font-size: 1.2em; } .fs-preview h3 { font-size: 1.05em; }
    .fs-preview p { margin: 0 0 0.7em; }
    .fs-preview code { background: #f1f5f9; border-radius: 5px; padding: 1px 5px; font-family: var(--mono); font-size: 0.9em; }
    .fs-preview pre { background: #0f172a; color: #e5eefb; border-radius: 8px; padding: 14px; overflow-x: auto; margin-bottom: 0.8em; }
    .fs-preview pre code { background: none; padding: 0; }
    .fs-preview ul,.fs-preview ol { padding-left: 1.5em; margin-bottom: 0.7em; }
    .fs-preview blockquote { border-left: 3px solid #cbd5e1; padding-left: 1em; color: #64748b; margin: 0 0 0.7em; }
    .fs-preview a { color: var(--accent); } .fs-preview hr { border: none; border-top: 1px solid var(--line-soft); margin: 1em 0; }
    .fs-preview img { max-width: 100%; }
    .fs-footer { display: flex; gap: 10px; justify-content: flex-end; padding: 12px 18px; border-top: 1px solid var(--focus-line); background: rgba(17,24,39,0.96); flex-shrink: 0; }
    .fs-footer .btn-edit { background: var(--focus-panel); border-color: var(--focus-line); color: var(--focus-muted); }
    .fs-footer .btn-save { background: var(--focus-green); box-shadow: 0 8px 18px rgba(34,197,94,0.18); }
    .fs-footer .btn-publish { background: var(--focus-accent); box-shadow: 0 8px 18px rgba(96,165,250,0.18); color: #07101f; }
    .btn-fs-trigger { background: var(--surface); border: 1px solid var(--line); border-radius: 6px; cursor: pointer; font-size: 12px; color: var(--muted); padding: 2px 7px; line-height: 1.4; vertical-align: middle; margin-left: 6px; }
    .btn-fs-trigger:hover { background: var(--surface-subtle); color: var(--text); }

    /* ── Auth overlay ── */
    #auth-overlay { display: none; position: fixed; inset: 0; z-index: 3000; background: color-mix(in srgb, var(--bg) 96%, transparent); backdrop-filter: blur(8px); align-items: center; justify-content: center; }
    #auth-overlay.visible { display: flex; }
    .auth-card { max-width: 420px; width: 100%; padding: 28px; margin: 20px; text-align: left; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--shadow); }
    #auth-overlay form { display: flex; gap: 8px; }
    #auth-overlay input { flex: 1; min-width: 0; padding: 11px 13px; border-radius: 8px; font-size: 14px; border: 1px solid var(--line); background: var(--surface); color: var(--text); outline: none; font-family: inherit; }
    #auth-overlay input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent); }
    #auth-overlay button[type=submit] { padding: 11px 18px; border-radius: 8px; font-size: 14px; font-weight: 800; background: var(--accent); color: #fff; border: none; cursor: pointer; }
    #auth-error { display: none; font-size: 13px; color: #b42318; margin-top: 12px; }
    @media (max-width: 860px) {
      .page-content { padding: 16px 12px 48px; }
      .topbar { flex-direction: column; padding: 16px; }
      .top-actions { width: 100%; justify-content: space-between; }
      .card-row { grid-template-columns: 1fr; }
      .card-actions { grid-template-columns: repeat(3, minmax(0, 1fr)); justify-content: stretch; }
      .card-actions .card-date { justify-self: start; }
      .card-actions .btn { width: 100%; }
      .form-row, .editor-split, .fs-meta, .fs-editor { grid-template-columns: 1fr !important; }
      .editor-split textarea, .preview-pane { height: 420px; }
      .fs-header { align-items: flex-start; flex-wrap: wrap; }
      .fs-titlebar { width: 100%; }
      .fs-meta { max-height: 38vh; overflow-y: auto; }
      .fs-tabs { display: flex; }
      .fs-editor { overflow-y: auto; display: block; }
      .fs-editor textarea, .fs-preview { min-height: calc(100vh - 220px); width: 100%; border-right: 0; }
      #fs-overlay[data-mobile-pane="editor"] .fs-preview { display: none; }
      #fs-overlay[data-mobile-pane="preview"] .fs-editor textarea { display: none; }
      #auth-overlay form { flex-direction: column; }
    }

    /* ── Mermaid zoom wrapper ── */
    .mermaid-wrap { position: relative; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; margin: 1rem 0; background: var(--surface); }
    .mermaid-toolbar { display: flex; gap: 4px; padding: 6px 10px; border-bottom: 1px solid var(--line); background: var(--surface-subtle); }
    .mermaid-zoom-btn { width: 28px; height: 28px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--text); cursor: pointer; font-size: 15px; display: flex; align-items: center; justify-content: center; transition: background 0.15s; }
    .mermaid-zoom-btn:hover { background: var(--glass); }
    .mermaid-viewport { overflow: hidden; cursor: grab; padding: 16px; min-height: 120px; height: 340px; }
    .mermaid-viewport:active { cursor: grabbing; }
    .mermaid-wrap:fullscreen,
    .mermaid-wrap:-webkit-full-screen { display: flex; flex-direction: column; background: var(--bg); border-radius: 0; border: none; }
    .mermaid-wrap:fullscreen .mermaid-viewport,
    .mermaid-wrap:-webkit-full-screen .mermaid-viewport { flex: 1; overflow: auto; }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/marked@14/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/mermaid@10.4.0/dist/mermaid.min.js"></script>
</head>
<body>
  <header class="site-header">
    <div class="nav-inner">
      <a class="nav-brand" href="/">Engineer News</a>
      <nav class="nav-links">
        <a class="nav-link" href="/categories">分類</a>
        <a class="nav-link" href="/projects">作品集</a>
        <span class="nav-badge">Admin</span>
      </nav>
      <div style="display:flex; align-items:center; gap:8px;">
        <div class="theme-picker">
          <button class="theme-btn" id="theme-btn" aria-label="Select theme">
            <span class="theme-dot"></span>
            <span id="theme-label">Theme</span>
          </button>
          <div class="theme-menu" id="theme-menu">
            <button class="theme-option" data-theme="dark"><span class="theme-swatch" style="background:#1c1c1e; border-color:#3a3a3c;"></span>Apple Dark</button>
            <button class="theme-option" data-theme="light"><span class="theme-swatch" style="background:#f2f2f7; border-color:#c6c6c8;"></span>Apple Light</button>
            <button class="theme-option" data-theme="warm"><span class="theme-swatch" style="background:#f7f3ea; border-color:#d97706;"></span>Warm Read</button>
            <button class="theme-option" data-theme="nord"><span class="theme-swatch" style="background:#3b4252; border-color:#88c0d0;"></span>Nord</button>
            <button class="theme-option" data-theme="catppuccin"><span class="theme-swatch" style="background:#313244; border-color:#89b4fa;"></span>Catppuccin</button>
            <button class="theme-option" data-theme="tokyo"><span class="theme-swatch" style="background:#24253a; border-color:#7aa2f7;"></span>Tokyo Night</button>
          </div>
        </div>
        <button id="btn-logout" class="btn btn-edit" style="height:32px; padding:0 12px; font-size:13px;">登出</button>
      </div>
    </div>
  </header>

  <div class="page-content">
  <div class="topbar">
    <div>
      <p class="eyebrow">Editorial Queue</p>
      <h1>Draft Review</h1>
      <p class="meta" id="meta">{drafts.length} 篇待審閱</p>
    </div>
    <div class="top-actions">
      <span class="count-badge" id="count-badge">{drafts.length} drafts</span>
    </div>
  </div>

  {drafts.length === 0 ? (
    <div class="empty">目前沒有待審閱的文章</div>
  ) : (
    <div id="draft-list">
      {drafts.map(post => (
        <div class="card" id={`card-${post.id.replace(/\//g, '-')}`}>
          <div class="card-row">
            <div class="card-body">
              <div class="card-title">{post.data.title}</div>
              {post.data.tldr && <p class="card-tldr">{post.data.tldr}</p>}
              <div class="card-tags">
                <span class="tag tag-cat" data-category={post.data.category}>{post.data.category}</span>
                {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
              {post.data.original_url && (
                <div class="card-links">
                  <a href={post.data.original_url} target="_blank" rel="noopener">▶ 原影片</a>
                </div>
              )}
            </div>
            <div class="card-actions">
              <span class="card-date">{post.data.date.toISOString().slice(0, 10)}</span>
              <button class="btn btn-edit" data-slug={post.id}>寫作</button>
              <button class="btn btn-publish" data-slug={post.id} data-title={post.data.title}>發布</button>
              <button class="btn btn-delete" data-slug={post.id} data-title={post.data.title}>刪除</button>
            </div>
          </div>

          <div class="edit-panel" id={`edit-${post.id.replace(/\//g, '-')}`}>
            <div class="edit-loading">載入中…</div>
            <form class="edit-form" data-slug={post.id}>
              <div class="form-row">
                <div class="form-group" style="grid-column: 1 / -1">
                  <label>標題</label>
                  <input name="title" type="text" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label>TL;DR</label>
                  <input name="tldr" type="text" />
                </div>
                <div class="form-group">
                  <label>Description</label>
                  <input name="description" type="text" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label>Category</label>
                  <select name="category">
                    {CATEGORIES.map(c => <option value={c}>{c}</option>)}
                  </select>
                </div>
                <div class="form-group">
                  <label>Tags (comma-separated)</label>
                  <input name="tags" type="text" placeholder="ai, llm, cloudflare" />
                </div>
              </div>
              <div class="form-row editor-split">
                <div class="form-group">
                  <label>
                    Markdown 內容
                    <button type="button" class="btn-fs-trigger" data-slug={post.id} title="全螢幕編輯 (Ctrl+Shift+F)">⛶</button>
                  </label>
                  <textarea name="body" rows="22"></textarea>
                </div>
                <div class="form-group">
                  <label>預覽</label>
                  <div class="preview-pane"></div>
                </div>
              </div>
              <div class="edit-footer">
                <button type="button" class="btn btn-save btn-save-draft">儲存草稿</button>
                <button type="button" class="btn btn-publish btn-publish-edit">發布</button>
              </div>
            </form>
          </div>
        </div>
      ))}
    </div>
  )}

  <footer class="site-footer">&copy; {new Date().getFullYear()} Engineer News</footer>
  </div><!-- /.page-content -->

  <div id="fs-overlay">
    <div class="fs-header">
      <div class="fs-titlebar">
        <div class="form-group" style="margin:0">
          <label style="font-size:11px;font-weight:800;color:var(--focus-muted);margin-bottom:3px;display:block">標題</label>
          <input name="title" type="text" />
        </div>
        <span class="fs-status" id="fs-status">Ready</span>
      </div>
      <button type="button" class="fs-meta-toggle" id="fs-meta-toggle">Metadata</button>
      <button class="btn-fs-close" id="fs-close-btn" title="關閉全螢幕 (ESC)">✕</button>
    </div>
    <div class="fs-meta">
      <div class="form-group">
        <label>TL;DR</label>
        <input name="tldr" type="text" />
      </div>
      <div class="form-group">
        <label>Description</label>
        <input name="description" type="text" />
      </div>
      <div class="form-group">
        <label>Category</label>
        <select name="category">
          {CATEGORIES.map(c => <option value={c}>{c}</option>)}
        </select>
      </div>
      <div class="form-group">
        <label>Tags (comma-separated)</label>
        <input name="tags" type="text" />
      </div>
    </div>
    <div class="fs-tabs" role="tablist" aria-label="Editor panes">
      <button type="button" class="fs-tab active" data-pane="editor">Editor</button>
      <button type="button" class="fs-tab" data-pane="preview">Preview</button>
    </div>
    <div class="fs-editor">
      <textarea id="fs-textarea" name="body"></textarea>
      <div class="fs-preview" id="fs-preview"></div>
    </div>
    <div class="fs-footer">
      <button type="button" class="btn btn-edit" id="fs-btn-exit">回到列表</button>
      <button type="button" class="btn btn-save" id="fs-btn-save">儲存草稿</button>
      <button type="button" class="btn btn-publish" id="fs-btn-publish">發布</button>
    </div>
  </div>

  <div id="auth-overlay">
    <div class="auth-card">
      <p class="eyebrow">Protected Area</p>
      <h1 style="font-size:26px;margin:0 0 8px">Draft Review</h1>
      <p style="font-size:14px;color:var(--muted);margin:0 0 22px;line-height:1.6">請輸入 admin token 以繼續審稿與編輯。</p>
      <form id="auth-form">
        <input id="auth-input" type="password" placeholder="ADMIN_TOKEN" autocomplete="current-password" />
        <button type="submit">Enter</button>
      </form>
      <p id="auth-error"></p>
    </div>
  </div>

  <div class="toast-container" id="toasts"></div>

  <script>
    // ── Theme picker ──────────────────────────────────────────────────────────
    (function () {
      var labels = { dark: 'Apple Dark', light: 'Apple Light', warm: 'Warm Read', nord: 'Nord', catppuccin: 'Catppuccin', tokyo: 'Tokyo Night' };
      function applyTheme(theme) {
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
        var lbl = document.getElementById('theme-label');
        if (lbl) lbl.textContent = labels[theme] || theme;
        document.querySelectorAll('.theme-option').forEach(function(btn) {
          btn.classList.toggle('active', btn.dataset.theme === theme);
        });
      }
      document.addEventListener('DOMContentLoaded', function () {
        var current = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        applyTheme(current);
        var btn = document.getElementById('theme-btn');
        var menu = document.getElementById('theme-menu');
        btn.addEventListener('click', function (e) { e.stopPropagation(); menu.classList.toggle('open'); });
        document.addEventListener('click', function () { menu.classList.remove('open'); });
        document.querySelectorAll('.theme-option').forEach(function (opt) {
          opt.addEventListener('click', function (e) { e.stopPropagation(); applyTheme(opt.dataset.theme); menu.classList.remove('open'); });
        });
      });
    })();

    // ── Mermaid utilities ────────────────────────────────────────────────────
    function debounce(fn, delay) {
      var t;
      return function () {
        var args = arguments;
        clearTimeout(t);
        t = setTimeout(function () { fn.apply(null, args); }, delay);
      };
    }

    if (window.mermaid) {
      var mermaidTheme = document.documentElement.getAttribute('data-theme') === 'light' ? 'default' : 'dark';
      mermaid.initialize({ startOnLoad: false, theme: mermaidTheme });
    }

    function addMermaidZoom(el) {
      if (el.closest('.mermaid-wrap')) return;

      var wrap = document.createElement('div');
      wrap.className = 'mermaid-wrap';

      var toolbar = document.createElement('div');
      toolbar.className = 'mermaid-toolbar';
      toolbar.innerHTML =
        '<button class="mermaid-zoom-btn" data-action="in" title="Zoom in">+</button>' +
        '<button class="mermaid-zoom-btn" data-action="out" title="Zoom out">−</button>' +
        '<button class="mermaid-zoom-btn" data-action="reset" title="Reset" style="font-size:11px">⊙</button>' +
        '<button class="mermaid-zoom-btn" data-action="fullscreen" title="Fullscreen" style="margin-left:auto;font-size:13px">⛶</button>';

      var vp = document.createElement('div');
      vp.className = 'mermaid-viewport';

      el.parentNode.insertBefore(wrap, el);
      wrap.appendChild(toolbar);
      wrap.appendChild(vp);
      vp.appendChild(el);

      var svg = null, baseW = 0, baseH = 0;
      var scale = 1, tx = 0, ty = 0;

      function initSvg() {
        svg = el.querySelector('svg');
        if (!svg) return;
        baseW = parseFloat(svg.getAttribute('width')) || svg.getBoundingClientRect().width;
        baseH = parseFloat(svg.getAttribute('height')) || svg.getBoundingClientRect().height;
        svg.style.maxWidth = 'none';
      }

      function apply() {
        if (svg && baseW) {
          svg.setAttribute('width', baseW * scale);
          svg.setAttribute('height', baseH * scale);
        }
        el.style.transform = 'translate(' + tx + 'px,' + ty + 'px)';
      }

      function fitAndCenter() {
        initSvg();
        var pad = 32;
        var vpW = vp.clientWidth - pad;
        var vpH = vp.clientHeight - pad;
        scale = 1;
        tx = Math.max(0, (vpW - baseW) / 2);
        ty = Math.max(0, (vpH - baseH) / 2);
        apply();
      }
      var fitOnce = new ResizeObserver(function (entries, obs) {
        var entry = entries[0];
        if (entry && entry.contentRect.width > 0) {
          obs.disconnect();
          fitAndCenter();
        }
      });
      fitOnce.observe(vp);

      var fsBtn = toolbar.querySelector('[data-action="fullscreen"]');
      var fsAbort = new AbortController();
      document.addEventListener('fullscreenchange', function () {
        var isFs = document.fullscreenElement === wrap;
        fsBtn.textContent = isFs ? '✕' : '⛶';
        fsBtn.title = isFs ? 'Exit fullscreen' : 'Fullscreen';
        if (isFs) requestAnimationFrame(fitAndCenter);
      }, { signal: fsAbort.signal });

      new MutationObserver(function (_, obs) {
        if (!document.contains(wrap)) {
          fsAbort.abort();
          obs.disconnect();
        }
      }).observe(document.body, { childList: true, subtree: true });

      toolbar.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-action]');
        if (!btn) return;
        var action = btn.dataset.action;
        if (action === 'reset') { scale = 1; fitAndCenter(); return; }
        if (action === 'fullscreen') {
          if (!document.fullscreenElement) wrap.requestFullscreen && wrap.requestFullscreen();
          else document.exitFullscreen && document.exitFullscreen();
          return;
        }
        var newScale = action === 'in' ? Math.min(scale * 1.3, 8) : Math.max(scale / 1.3, 0.1);
        var cx = vp.clientWidth / 2 - 16;
        var cy = vp.clientHeight / 2 - 16;
        tx = cx - (cx - tx) * (newScale / scale);
        ty = cy - (cy - ty) * (newScale / scale);
        scale = newScale;
        apply();
      });

      vp.addEventListener('wheel', function (e) {
        e.preventDefault();
        var rect = vp.getBoundingClientRect();
        var mx = e.clientX - rect.left - 16;
        var my = e.clientY - rect.top - 16;
        var factor = e.deltaY < 0 ? 1.12 : 0.88;
        var newScale = Math.max(0.1, Math.min(8, scale * factor));
        tx = mx - (mx - tx) * (newScale / scale);
        ty = my - (my - ty) * (newScale / scale);
        scale = newScale;
        apply();
      }, { passive: false });

      var dragging = false, sx, sy, stx, sty;
      vp.addEventListener('pointerdown', function (e) {
        dragging = true; sx = e.clientX; sy = e.clientY; stx = tx; sty = ty;
        vp.setPointerCapture(e.pointerId);
      });
      vp.addEventListener('pointermove', function (e) {
        if (!dragging) return;
        tx = stx + e.clientX - sx;
        ty = sty + e.clientY - sy;
        apply();
      });
      vp.addEventListener('pointerup', function () { dragging = false; });
    }

    function renderMermaidInEl(container) {
      if (!window.mermaid) return;
      var nodes = container.querySelectorAll('pre > code.language-mermaid, pre > code.lang-mermaid');
      if (!nodes.length) return;

      var mermaidEls = [];
      nodes.forEach(function (node) {
        var pre = node.parentElement;
        var text = pre.textContent || '';
        var div = document.createElement('div');
        div.className = 'mermaid';
        div.textContent = text;
        pre.parentNode.insertBefore(div, pre.nextSibling);
        pre.style.display = 'none';
        mermaidEls.push(div);
      });

      mermaid.run({ nodes: mermaidEls }).then(function () {
        mermaidEls.forEach(addMermaidZoom);
      }).catch(function (e) {
        console.error('mermaid render error', e);
      });
    }

    // ── Session ──────────────────────────────────────────────────────────────
    const TOKEN_KEY = 'admin_token';
    const SESSION_TTL = 36 * 60 * 60 * 1000;

    function loadSession() {
      try {
        const raw = localStorage.getItem(TOKEN_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (typeof parsed === 'string') { localStorage.removeItem(TOKEN_KEY); return null; }
        const { token, loginAt } = parsed;
        if (Date.now() - loginAt > SESSION_TTL) { localStorage.removeItem(TOKEN_KEY); return null; }
        return token;
      } catch { return null; }
    }

    function saveSession(t) {
      localStorage.setItem(TOKEN_KEY, JSON.stringify({ token: t, loginAt: Date.now() }));
    }

    let token = loadSession();

    // ── Auth overlay ──────────────────────────────────────────────────────────
    const authOverlay = document.getElementById('auth-overlay');
    const authError = document.getElementById('auth-error');

    function showAuth() {
      authOverlay.classList.add('visible');
      document.getElementById('auth-input').focus();
    }

    function hideAuth() {
      authOverlay.classList.remove('visible');
    }

    if (!token) showAuth();

    document.getElementById('btn-logout').addEventListener('click', () => {
      localStorage.removeItem(TOKEN_KEY);
      token = null;
      showAuth();
    });

    document.getElementById('auth-form').addEventListener('submit', async e => {
      e.preventDefault();
      const input = document.getElementById('auth-input');
      const t = input.value.trim();
      if (!t) return;
      authError.style.display = 'none';
      try {
        const res = await fetch(`/api/admin/stats?token=${encodeURIComponent(t)}`);
        if (res.status === 401) { authError.textContent = 'Token 不正確'; authError.style.display = 'block'; return; }
        saveSession(t);
        token = t;
        hideAuth();
      } catch {
        authError.textContent = '驗證失敗，請稍後再試';
        authError.style.display = 'block';
      }
    });

    // ── Helpers ───────────────────────────────────────────────────────────────
    function showToast(msg, type, duration) {
      const container = document.getElementById('toasts');
      const el = document.createElement('div');
      el.className = `toast ${type ?? ''}`;
      el.innerHTML = msg;
      container.appendChild(el);
      setTimeout(() => el.remove(), duration ?? 5000);
    }

    function cardId(slug) { return `card-${slug.replace(/\//g, '-')}`; }
    function editId(slug) { return `edit-${slug.replace(/\//g, '-')}`; }
    function updateDraftCount() {
      const remaining = document.querySelectorAll('#draft-list .card').length;
      document.getElementById('meta').textContent = `${remaining} 篇待審閱`;
      document.getElementById('count-badge').textContent = `${remaining} drafts`;
      if (remaining === 0) {
        document.getElementById('draft-list').innerHTML = '<div class="empty">目前沒有待審閱的文章</div>';
      }
    }

    // ── Fullscreen editor ──
    const fsOverlay = document.getElementById('fs-overlay');
    const fsTextarea = document.getElementById('fs-textarea');
    const fsPreview = document.getElementById('fs-preview');
    const fsStatus = document.getElementById('fs-status');
    const fsMeta = fsOverlay.querySelector('.fs-meta');
    const fsFields = ['title', 'tldr', 'description', 'category', 'tags'];
    let fsDirty = false;
    let fsSavedTimer = null;

    function setEditorStatus(label, state) {
      fsStatus.textContent = label;
      fsStatus.className = `fs-status ${state ?? ''}`;
    }

    function markEditorDirty() {
      fsDirty = true;
      setEditorStatus('Unsaved', 'dirty');
    }

    function markEditorClean() {
      fsDirty = false;
      setEditorStatus('Saved', 'saved');
      clearTimeout(fsSavedTimer);
      fsSavedTimer = setTimeout(() => {
        if (!fsDirty && fsOverlay.classList.contains('open')) setEditorStatus('Ready', '');
      }, 2200);
    }

    function renderPreview(markdown) {
      fsPreview.innerHTML = marked.parse(markdown);
    }

    function openFullscreen(slug) {
      const panel = document.getElementById(editId(slug));
      if (!panel) return;
      const cardForm = panel.querySelector('.edit-form.ready');
      if (!cardForm) return;


      fsFields.forEach(name => {
        fsOverlay.querySelector(`[name=${name}]`).value = cardForm.querySelector(`[name=${name}]`).value;
      });
      fsTextarea.value = cardForm.querySelector('[name=body]').value;
      fsOverlay.dataset.slug = slug;
      fsOverlay.dataset.frontmatter = cardForm.dataset.frontmatter ?? '{}';
      fsOverlay.dataset.mobilePane = 'editor';

      renderPreview(fsTextarea.value);
      markEditorClean();

      fsOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';
      fsTextarea.focus();
    }

    function closeFullscreen() {
      if (!fsOverlay.classList.contains('open')) return;
      if (fsDirty && !confirm('目前有尚未儲存的變更，確定要離開全螢幕編輯器？')) return;
      document.body.style.overflow = '';
      const slug = fsOverlay.dataset.slug;

      if (slug) {
        const panel = document.getElementById(editId(slug));
        if (panel) {
          const cardForm = panel.querySelector('.edit-form');
          if (cardForm) {
            fsFields.forEach(name => {
              cardForm.querySelector(`[name=${name}]`).value = fsOverlay.querySelector(`[name=${name}]`).value;
            });
            cardForm.querySelector('[name=body]').value = fsTextarea.value;
            cardForm.dataset.frontmatter = fsOverlay.dataset.frontmatter;
            const cardPreviewPane = cardForm.querySelector('.preview-pane');
            if (cardPreviewPane) cardPreviewPane.innerHTML = marked.parse(fsTextarea.value);
          }
        }
      }

      fsOverlay.classList.remove('open');
    }

    document.querySelectorAll('.btn-fs-trigger').forEach(btn => {
      btn.addEventListener('click', () => openFullscreen(btn.dataset.slug));
    });

    document.getElementById('fs-close-btn').addEventListener('click', closeFullscreen);
    document.getElementById('fs-btn-exit').addEventListener('click', closeFullscreen);
    document.getElementById('fs-meta-toggle').addEventListener('click', () => {
      fsMeta.classList.toggle('collapsed');
    });
    document.querySelectorAll('.fs-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.fs-tab').forEach(t => t.classList.toggle('active', t === tab));
        fsOverlay.dataset.mobilePane = tab.dataset.pane;
      });
    });

    fsFields.forEach(name => {
      fsOverlay.querySelector(`[name=${name}]`).addEventListener('input', markEditorDirty);
      fsOverlay.querySelector(`[name=${name}]`).addEventListener('change', markEditorDirty);
    });

    document.addEventListener('keydown', e => {
      // ESC 關閉全螢幕
      if (e.key === 'Escape' && fsOverlay.classList.contains('open')) {
        closeFullscreen();
        return;
      }
      // Ctrl+Shift+F / Cmd+Shift+F 開啟全螢幕
      if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key.toLowerCase() === 'f') {
        if (fsOverlay.classList.contains('open')) return;
        const openPanels = document.querySelectorAll('.edit-panel.open');
        if (openPanels.length === 1) {
          e.preventDefault();
          const form = openPanels[0].querySelector('.edit-form.ready');
          if (form) openFullscreen(form.dataset.slug);
        }
      }
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's' && fsOverlay.classList.contains('open')) {
        e.preventDefault();
        document.getElementById('fs-btn-save').click();
      }
    });

    // 同步捲動
    let fsSyncing = false;
    fsTextarea.addEventListener('scroll', () => {
      if (fsSyncing) return;
      fsSyncing = true;
      const pct = fsTextarea.scrollTop / (fsTextarea.scrollHeight - fsTextarea.clientHeight) || 0;
      fsPreview.scrollTop = pct * (fsPreview.scrollHeight - fsPreview.clientHeight);
      fsSyncing = false;
    });
    fsPreview.addEventListener('scroll', () => {
      if (fsSyncing) return;
      fsSyncing = true;
      const pct = fsPreview.scrollTop / (fsPreview.scrollHeight - fsPreview.clientHeight) || 0;
      fsTextarea.scrollTop = pct * (fsTextarea.scrollHeight - fsTextarea.clientHeight);
      fsSyncing = false;
    });

    // 即時預覽更新
    fsTextarea.addEventListener('input', () => {
      renderPreview(fsTextarea.value);
      markEditorDirty();
    });

    function syncOverlayToCardForm() {
      const slug = fsOverlay.dataset.slug;
      if (!slug) return null;
      const panel = document.getElementById(editId(slug));
      if (!panel) return null;
      const cardForm = panel.querySelector('.edit-form');
      if (!cardForm) return null;
      fsFields.forEach(name => {
        cardForm.querySelector(`[name=${name}]`).value = fsOverlay.querySelector(`[name=${name}]`).value;
      });
      cardForm.querySelector('[name=body]').value = fsTextarea.value;
      cardForm.dataset.frontmatter = fsOverlay.dataset.frontmatter;
      return cardForm;
    }

    document.getElementById('fs-btn-save').addEventListener('click', async () => {
      const cardForm = syncOverlayToCardForm();
      if (!cardForm) return;
      const fsBtns = [document.getElementById('fs-btn-save'), document.getElementById('fs-btn-publish')];
      fsBtns.forEach(b => { b.disabled = true; });
      setEditorStatus('Saving', 'saving');
      const ok = await submitEdit(cardForm, false);
      if (ok) markEditorClean();
      else markEditorDirty();
      fsBtns.forEach(b => { b.disabled = false; });
    });

    document.getElementById('fs-btn-publish').addEventListener('click', async () => {
      const slug = fsOverlay.dataset.slug;
      const cardForm = syncOverlayToCardForm();
      if (!cardForm) return;
      const title = fsOverlay.querySelector('[name=title]').value.trim() || '未命名文章';
      if (!confirm(`確定要發布「${title}」？\n這會儲存目前內容並將 draft 設為 false。`)) return;
      const fsBtns = [document.getElementById('fs-btn-save'), document.getElementById('fs-btn-publish')];
      fsBtns.forEach(b => { b.disabled = true; });
      setEditorStatus('Publishing', 'saving');
      const ok = await submitEdit(cardForm, true);
      fsBtns.forEach(b => { b.disabled = false; });
      // submitEdit 在發布成功後移除 card；若 card 已移除，closeFullscreen 會跳過 copy-back
      if (ok && !document.getElementById(cardId(slug))) {
        fsDirty = false;
        closeFullscreen();
      } else if (!ok) {
        markEditorDirty();
      }
    });

    async function loadDraftIntoForm(slug, panel, form) {
      const res = await fetch(`/api/admin/raw?slug=${encodeURIComponent(slug)}&token=${token}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);

      const fm = data.frontmatter;
      form.querySelector('[name=title]').value = fm.title ?? '';
      form.querySelector('[name=tldr]').value = fm.tldr ?? '';
      form.querySelector('[name=description]').value = fm.description ?? '';
      form.querySelector('[name=category]').value = fm.category ?? 'tech';
      form.querySelector('[name=tags]').value = Array.isArray(fm.tags) ? fm.tags.join(', ') : (fm.tags ?? '');
      const bodyTextarea = form.querySelector('[name=body]');
      bodyTextarea.value = data.body;
      form.dataset.frontmatter = JSON.stringify(fm);

      panel.querySelector('.edit-loading').style.display = 'none';
      form.classList.add('ready');

      const previewPane = form.querySelector('.preview-pane');
      const updatePreview = () => { previewPane.innerHTML = marked.parse(bodyTextarea.value); };
      updatePreview();
      bodyTextarea.addEventListener('input', updatePreview);
    }

    document.querySelectorAll('.card-actions .btn-edit').forEach(btn => {
      btn.addEventListener('click', async () => {
        const slug = btn.dataset.slug;
        const panel = document.getElementById(editId(slug));
        const form = panel.querySelector('.edit-form');

        if (form.classList.contains('ready')) {
          openFullscreen(slug);
          return;
        }

        try {
          btn.disabled = true;
          btn.textContent = '載入中';
          await loadDraftIntoForm(slug, panel, form);
          openFullscreen(slug);
        } catch (err) {
          showToast(`載入失敗：${err.message}`, 'error');
        } finally {
          btn.disabled = false;
          btn.textContent = '寫作';
        }
      });
    });

    async function submitEdit(form, publishNow) {
      const slug = form.dataset.slug;
      const fm = JSON.parse(form.dataset.frontmatter ?? '{}');

      fm.title = form.querySelector('[name=title]').value.trim();
      fm.tldr = form.querySelector('[name=tldr]').value.trim();
      fm.description = form.querySelector('[name=description]').value.trim();
      fm.category = form.querySelector('[name=category]').value;
      fm.tags = form.querySelector('[name=tags]').value
        .split(',').map(t => t.trim()).filter(Boolean);
      fm.draft = !publishNow;

      const body = form.querySelector('[name=body]').value;
      const saveBtns = form.querySelectorAll('button');
      saveBtns.forEach(b => { b.disabled = true; });

      try {
        const res = await fetch(`/api/admin/save?token=${token}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, frontmatter: fm, body }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);

        const sha = data.commitSha.slice(0, 7);

        if (publishNow) {
          document.getElementById(cardId(slug))?.remove();
          showToast(
            `✅ 已發布 <strong>${fm.title}</strong>（${sha}）— <a href="${data.actionsUrl}" target="_blank">查看部署 →</a>`,
            'success', 8000
          );
          updateDraftCount();
        } else {
          showToast(`💾 草稿已儲存（${sha}）`, 'success', 4000);
          form.dataset.frontmatter = JSON.stringify(fm);
          saveBtns.forEach(b => { b.disabled = false; });
          return true;
        }
      } catch (err) {
        showToast(`❌ 儲存失敗：${err.message}`, 'error');
        saveBtns.forEach(b => { b.disabled = false; });
        return false;
      }
      return true;
    }

    document.querySelectorAll('.btn-save-draft').forEach(btn => {
      btn.addEventListener('click', () => submitEdit(btn.closest('form'), false));
    });
    document.querySelectorAll('.btn-publish-edit').forEach(btn => {
      btn.addEventListener('click', () => submitEdit(btn.closest('form'), true));
    });

    document.querySelectorAll('.btn-delete').forEach(btn => {
      btn.addEventListener('click', async () => {
        const slug = btn.dataset.slug;
        const title = btn.dataset.title;
        if (!confirm(`確定要刪除「${title}」？\n文章會移至 _trash/ 目錄，可從 git 復原。`)) return;
        btn.disabled = true;
        btn.textContent = '刪除中…';
        try {
          const res = await fetch(`/api/admin/delete?token=${token}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);
          document.getElementById(cardId(slug))?.remove();
          showToast(`🗑 已移至垃圾桶：${title}`, 'success', 4000);
          updateDraftCount();
        } catch (err) {
          showToast(`❌ 刪除失敗：${err.message}`, 'error');
          btn.disabled = false;
          btn.textContent = '刪除';
        }
      });
    });

    document.querySelectorAll('.card-actions .btn-publish').forEach(btn => {
      btn.addEventListener('click', async () => {
        const slug = btn.dataset.slug;
        const title = btn.dataset.title;
        btn.disabled = true;
        btn.textContent = '發布中…';

        try {
          const res = await fetch(`/api/admin/publish?token=${token}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);

          document.getElementById(cardId(slug))?.remove();
          const sha = data.commitSha.slice(0, 7);
          showToast(
            `✅ 已發布 <strong>${title}</strong>（${sha}）— <a href="${data.actionsUrl}" target="_blank">查看部署 →</a>`,
            'success', 8000
          );
          updateDraftCount();
        } catch (err) {
          showToast(`❌ 發布失敗：${err.message}`, 'error');
          btn.disabled = false;
          btn.textContent = '發布';
        }
      });
    });

    window.addEventListener('beforeunload', e => {
      if (!fsDirty) return;
      e.preventDefault();
      e.returnValue = '';
    });
  </script>
</body>
</html>

---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => data.draft === true && data.lang === 'zh-TW');
const drafts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const CATEGORIES = ['tech', 'product', 'learning', 'career', 'life', 'creative'];
---

<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Review Drafts</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; max-width: 900px; margin: 0 auto; padding: 32px 16px; background: #f9f9f9; color: #1a1a1a; }
    h1 { font-size: 20px; font-weight: 600; margin: 0 0 8px; }
    .meta { font-size: 13px; color: #666; margin-bottom: 32px; }
    .card { background: #fff; border: 1px solid #e5e5e5; border-radius: 10px; padding: 20px 24px; margin-bottom: 16px; }
    .card-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
    .card-body { flex: 1; min-width: 0; }
    .card-title { font-size: 16px; font-weight: 600; margin: 0 0 6px; }
    .card-tldr { font-size: 13px; color: #555; margin: 0 0 10px; }
    .card-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
    .tag { font-size: 11px; background: #f0f0f0; border-radius: 4px; padding: 2px 8px; color: #444; }
    .tag-cat { background: #e8f0fe; color: #1a73e8; }
    .card-links { font-size: 12px; }
    .card-links a { color: #0066cc; text-decoration: none; }
    .card-links a:hover { text-decoration: underline; }
    .card-date { font-size: 12px; color: #999; }
    .card-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; flex-shrink: 0; }
    .btn { border: none; border-radius: 8px; padding: 8px 16px; font-size: 13px; font-weight: 500; cursor: pointer; transition: background 0.15s; }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .btn-edit { background: #f0f0f0; color: #333; }
    .btn-edit:hover { background: #e0e0e0; }
    .btn-edit.active { background: #e8f0fe; color: #1a73e8; }
    .btn-publish { background: #0a84ff; color: #fff; }
    .btn-publish:hover:not(:disabled) { background: #006edb; }
    .btn-save { background: #34a853; color: #fff; }
    .btn-save:hover:not(:disabled) { background: #2d8f47; }
    .edit-panel { display: none; border-top: 1px solid #e5e5e5; margin-top: 16px; padding-top: 20px; }
    .edit-panel.open { display: block; }
    .edit-loading { color: #888; font-size: 13px; padding: 8px 0; }
    .edit-form { display: none; }
    .edit-form.ready { display: block; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; }
    .form-row.full { grid-template-columns: 1fr; }
    .form-group { display: flex; flex-direction: column; gap: 4px; }
    .form-group label { font-size: 12px; font-weight: 500; color: #555; }
    .form-group input, .form-group select, .form-group textarea {
      border: 1px solid #ddd; border-radius: 6px; padding: 8px 10px; font-size: 13px;
      font-family: inherit; outline: none; transition: border-color 0.15s;
    }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: #0a84ff; }
    .form-group textarea { resize: vertical; font-family: 'SF Mono', 'Fira Code', monospace; font-size: 12px; line-height: 1.6; }
    .edit-footer { display: flex; gap: 8px; justify-content: flex-end; margin-top: 12px; }
    .toast-container { position: fixed; bottom: 24px; right: 24px; display: flex; flex-direction: column; gap: 8px; z-index: 100; }
    .toast { background: #1a1a1a; color: #fff; border-radius: 8px; padding: 12px 16px; font-size: 13px; max-width: 360px; animation: slide-in 0.2s ease; }
    .toast.success { background: #1c7c4a; }
    .toast.error { background: #c0392b; }
    .toast a { color: #a8d8ff; text-decoration: none; }
    @keyframes slide-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
    .empty { text-align: center; padding: 64px 0; color: #888; }
    .btn-delete { background: #fef2f2; color: #dc2626; }
    .btn-delete:hover:not(:disabled) { background: #fee2e2; }
    .editor-split { grid-template-columns: 1fr 1fr !important; }
    .editor-split textarea { height: 420px; min-height: 120px; }
    .preview-pane { border: 1px solid #ddd; border-radius: 6px; padding: 12px 16px; height: 420px; overflow-y: auto; font-size: 13px; line-height: 1.7; background: #fafafa; }
    .preview-pane h1,.preview-pane h2,.preview-pane h3 { font-weight: 600; margin: 0.8em 0 0.3em; }
    .preview-pane h1 { font-size: 1.4em; } .preview-pane h2 { font-size: 1.2em; } .preview-pane h3 { font-size: 1.05em; }
    .preview-pane p { margin: 0 0 0.7em; }
    .preview-pane code { background: #f0f0f0; border-radius: 3px; padding: 1px 4px; font-family: 'SF Mono', monospace; font-size: 0.9em; }
    .preview-pane pre { background: #1a1a1a; color: #e5e5e5; border-radius: 6px; padding: 12px; overflow-x: auto; margin-bottom: 0.8em; }
    .preview-pane pre code { background: none; padding: 0; }
    .preview-pane ul,.preview-pane ol { padding-left: 1.5em; margin-bottom: 0.7em; }
    .preview-pane blockquote { border-left: 3px solid #ddd; padding-left: 1em; color: #666; margin: 0 0 0.7em; }
    .preview-pane a { color: #0066cc; } .preview-pane hr { border: none; border-top: 1px solid #e5e5e5; margin: 1em 0; }
    .preview-pane img { max-width: 100%; }

    /* ── Fullscreen overlay ── */
    #fs-overlay { display: none; position: fixed; inset: 0; z-index: 1000; background: #fff; flex-direction: column; }
    #fs-overlay.open { display: flex; }
    .fs-header { display: flex; align-items: center; gap: 12px; padding: 12px 20px; border-bottom: 1px solid #e5e5e5; flex-shrink: 0; }
    .fs-header input[name=title] { flex: 1; font-size: 15px; font-weight: 600; }
    .btn-fs-close { background: none; border: 1px solid #ddd; border-radius: 6px; font-size: 16px; cursor: pointer; color: #555; padding: 2px 10px; line-height: 1.6; }
    .btn-fs-close:hover { background: #f0f0f0; }
    .fs-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 10px 20px; border-bottom: 1px solid #e5e5e5; flex-shrink: 0; }
    .fs-editor { display: grid; grid-template-columns: 1fr 1fr; flex: 1; min-height: 0; }
    .fs-editor textarea { border: none; border-right: 1px solid #e5e5e5; resize: none; padding: 14px 18px; font-family: 'SF Mono', 'Fira Code', monospace; font-size: 12px; line-height: 1.6; outline: none; height: 100%; }
    .fs-preview { padding: 14px 18px; overflow-y: auto; font-size: 13px; line-height: 1.7; }
    .fs-preview h1,.fs-preview h2,.fs-preview h3 { font-weight: 600; margin: 0.8em 0 0.3em; }
    .fs-preview h1 { font-size: 1.4em; } .fs-preview h2 { font-size: 1.2em; } .fs-preview h3 { font-size: 1.05em; }
    .fs-preview p { margin: 0 0 0.7em; }
    .fs-preview code { background: #f0f0f0; border-radius: 3px; padding: 1px 4px; font-family: 'SF Mono', monospace; font-size: 0.9em; }
    .fs-preview pre { background: #1a1a1a; color: #e5e5e5; border-radius: 6px; padding: 12px; overflow-x: auto; margin-bottom: 0.8em; }
    .fs-preview pre code { background: none; padding: 0; }
    .fs-preview ul,.fs-preview ol { padding-left: 1.5em; margin-bottom: 0.7em; }
    .fs-preview blockquote { border-left: 3px solid #ddd; padding-left: 1em; color: #666; margin: 0 0 0.7em; }
    .fs-preview a { color: #0066cc; } .fs-preview hr { border: none; border-top: 1px solid #e5e5e5; margin: 1em 0; }
    .fs-preview img { max-width: 100%; }
    .fs-footer { display: flex; gap: 8px; justify-content: flex-end; padding: 10px 20px; border-top: 1px solid #e5e5e5; flex-shrink: 0; }
    .btn-fs-trigger { background: none; border: none; cursor: pointer; font-size: 13px; color: #aaa; padding: 0 2px; line-height: 1; vertical-align: middle; margin-left: 4px; }
    .btn-fs-trigger:hover { color: #333; }

    /* ── Auth overlay ── */
    #auth-overlay { display: none; position: fixed; inset: 0; z-index: 3000; background: #f9f9f9; align-items: center; justify-content: center; }
    #auth-overlay.visible { display: flex; }
    #auth-overlay form { display: flex; gap: 8px; }
    #auth-overlay input { flex: 1; padding: 10px 14px; border-radius: 8px; font-size: 14px; border: 1px solid #ddd; background: #fff; outline: none; font-family: inherit; }
    #auth-overlay input:focus { border-color: #0a84ff; }
    #auth-overlay button[type=submit] { padding: 10px 18px; border-radius: 8px; font-size: 14px; font-weight: 700; background: #0a84ff; color: #fff; border: none; cursor: pointer; }
    #auth-error { display: none; font-size: 13px; color: #c0392b; margin-top: 12px; }
  </style>
  <script src="https://cdn.jsdelivr.net/npm/marked@14/marked.min.js"></script>
</head>
<body>
  <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px">
    <h1 style="margin:0">Draft Review</h1>
    <button id="btn-logout" class="btn" style="font-size:12px;color:#999;background:none;border:1px solid #e5e5e5;padding:4px 12px">登出</button>
  </div>
  <p class="meta" id="meta">{drafts.length} 篇待審閱</p>

  {drafts.length === 0 ? (
    <div class="empty">🎉 沒有待審閱的文章</div>
  ) : (
    <div id="draft-list">
      {drafts.map(post => (
        <div class="card" id={`card-${post.id.replace(/\//g, '-')}`}>
          <div class="card-row">
            <div class="card-body">
              <div class="card-title">{post.data.title}</div>
              {post.data.tldr && <p class="card-tldr">{post.data.tldr}</p>}
              <div class="card-tags">
                <span class="tag tag-cat">{post.data.category}</span>
                {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
              {post.data.original_url && (
                <div class="card-links">
                  <a href={post.data.original_url} target="_blank" rel="noopener">▶ 原影片</a>
                </div>
              )}
            </div>
            <div class="card-actions">
              <span class="card-date">{post.data.date.toISOString().slice(0, 10)}</span>
              <button class="btn btn-edit" data-slug={post.id}>編輯 ▾</button>
              <button class="btn btn-publish" data-slug={post.id} data-title={post.data.title}>發布</button>
              <button class="btn btn-delete" data-slug={post.id} data-title={post.data.title}>刪除</button>
            </div>
          </div>

          <div class="edit-panel" id={`edit-${post.id.replace(/\//g, '-')}`}>
            <div class="edit-loading">載入中…</div>
            <form class="edit-form" data-slug={post.id}>
              <div class="form-row">
                <div class="form-group" style="grid-column: 1 / -1">
                  <label>標題</label>
                  <input name="title" type="text" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label>TL;DR</label>
                  <input name="tldr" type="text" />
                </div>
                <div class="form-group">
                  <label>Description</label>
                  <input name="description" type="text" />
                </div>
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label>Category</label>
                  <select name="category">
                    {CATEGORIES.map(c => <option value={c}>{c}</option>)}
                  </select>
                </div>
                <div class="form-group">
                  <label>Tags (comma-separated)</label>
                  <input name="tags" type="text" placeholder="ai, llm, cloudflare" />
                </div>
              </div>
              <div class="form-row editor-split">
                <div class="form-group">
                  <label>
                    Markdown 內容
                    <button type="button" class="btn-fs-trigger" data-slug={post.id} title="全螢幕編輯 (Ctrl+Shift+F)">⛶</button>
                  </label>
                  <textarea name="body" rows="22"></textarea>
                </div>
                <div class="form-group">
                  <label>預覽</label>
                  <div class="preview-pane"></div>
                </div>
              </div>
              <div class="edit-footer">
                <button type="button" class="btn btn-save btn-save-draft">儲存草稿</button>
                <button type="button" class="btn btn-publish btn-publish-edit">發布</button>
              </div>
            </form>
          </div>
        </div>
      ))}
    </div>
  )}

  <div id="fs-overlay">
    <div class="fs-header">
      <div class="form-group" style="flex:1;margin:0">
        <label style="font-size:11px;font-weight:500;color:#888;margin-bottom:3px;display:block">標題</label>
        <input name="title" type="text" />
      </div>
      <button class="btn-fs-close" id="fs-close-btn" title="關閉全螢幕 (ESC)">✕</button>
    </div>
    <div class="fs-meta">
      <div class="form-group">
        <label>TL;DR</label>
        <input name="tldr" type="text" />
      </div>
      <div class="form-group">
        <label>Description</label>
        <input name="description" type="text" />
      </div>
      <div class="form-group">
        <label>Category</label>
        <select name="category">
          {CATEGORIES.map(c => <option value={c}>{c}</option>)}
        </select>
      </div>
      <div class="form-group">
        <label>Tags (comma-separated)</label>
        <input name="tags" type="text" />
      </div>
    </div>
    <div class="fs-editor">
      <textarea id="fs-textarea" name="body"></textarea>
      <div class="fs-preview" id="fs-preview"></div>
    </div>
    <div class="fs-footer">
      <button type="button" class="btn btn-save" id="fs-btn-save">儲存草稿</button>
      <button type="button" class="btn btn-publish" id="fs-btn-publish">發布</button>
    </div>
  </div>

  <div id="auth-overlay">
    <div style="max-width:380px;width:100%;text-align:center;padding:0 16px">
      <div style="font-size:40px;margin-bottom:12px">🛠</div>
      <h1 style="font-size:22px;font-weight:900;margin:0 0 6px">Draft Review</h1>
      <p style="font-size:14px;color:#666;margin:0 0 28px">請輸入 admin token 以繼續</p>
      <form id="auth-form">
        <input id="auth-input" type="password" placeholder="ADMIN_TOKEN" autocomplete="current-password" />
        <button type="submit">Enter</button>
      </form>
      <p id="auth-error"></p>
    </div>
  </div>

  <div class="toast-container" id="toasts"></div>

  <script>
    // ── Session ──────────────────────────────────────────────────────────────
    const TOKEN_KEY = 'admin_token';
    const SESSION_TTL = 36 * 60 * 60 * 1000;

    function loadSession() {
      try {
        const raw = localStorage.getItem(TOKEN_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (typeof parsed === 'string') { localStorage.removeItem(TOKEN_KEY); return null; }
        const { token, loginAt } = parsed;
        if (Date.now() - loginAt > SESSION_TTL) { localStorage.removeItem(TOKEN_KEY); return null; }
        return token;
      } catch { return null; }
    }

    function saveSession(t) {
      localStorage.setItem(TOKEN_KEY, JSON.stringify({ token: t, loginAt: Date.now() }));
    }

    let token = loadSession();

    // ── Auth overlay ──────────────────────────────────────────────────────────
    const authOverlay = document.getElementById('auth-overlay');
    const authError = document.getElementById('auth-error');

    function showAuth() {
      authOverlay.classList.add('visible');
      document.getElementById('auth-input').focus();
    }

    function hideAuth() {
      authOverlay.classList.remove('visible');
    }

    if (!token) showAuth();

    document.getElementById('btn-logout').addEventListener('click', () => {
      localStorage.removeItem(TOKEN_KEY);
      token = null;
      showAuth();
    });

    document.getElementById('auth-form').addEventListener('submit', async e => {
      e.preventDefault();
      const input = document.getElementById('auth-input');
      const t = input.value.trim();
      if (!t) return;
      authError.style.display = 'none';
      try {
        const res = await fetch(`/api/admin/stats?token=${encodeURIComponent(t)}`);
        if (res.status === 401) { authError.textContent = 'Token 不正確'; authError.style.display = 'block'; return; }
        saveSession(t);
        token = t;
        hideAuth();
      } catch {
        authError.textContent = '驗證失敗，請稍後再試';
        authError.style.display = 'block';
      }
    });

    // ── Helpers ───────────────────────────────────────────────────────────────
    function showToast(msg, type, duration) {
      const container = document.getElementById('toasts');
      const el = document.createElement('div');
      el.className = `toast ${type ?? ''}`;
      el.innerHTML = msg;
      container.appendChild(el);
      setTimeout(() => el.remove(), duration ?? 5000);
    }

    function cardId(slug) { return `card-${slug.replace(/\//g, '-')}`; }
    function editId(slug) { return `edit-${slug.replace(/\//g, '-')}`; }

    // ── Fullscreen editor ──
    const fsOverlay = document.getElementById('fs-overlay');
    const fsTextarea = document.getElementById('fs-textarea');
    const fsPreview = document.getElementById('fs-preview');
    const fsFields = ['title', 'tldr', 'description', 'category', 'tags'];
    function openFullscreen(slug) {
      const panel = document.getElementById(editId(slug));
      if (!panel) return;
      const cardForm = panel.querySelector('.edit-form.ready');
      if (!cardForm) return;


      fsFields.forEach(name => {
        fsOverlay.querySelector(`[name=${name}]`).value = cardForm.querySelector(`[name=${name}]`).value;
      });
      fsTextarea.value = cardForm.querySelector('[name=body]').value;
      fsOverlay.dataset.slug = slug;
      fsOverlay.dataset.frontmatter = cardForm.dataset.frontmatter ?? '{}';

      fsPreview.innerHTML = marked.parse(fsTextarea.value);

      fsOverlay.classList.add('open');
      document.body.style.overflow = 'hidden';
      fsTextarea.focus();
    }

    function closeFullscreen() {
      document.body.style.overflow = '';
      if (!fsOverlay.classList.contains('open')) return;
      const slug = fsOverlay.dataset.slug;

      if (slug) {
        const panel = document.getElementById(editId(slug));
        if (panel) {
          const cardForm = panel.querySelector('.edit-form');
          if (cardForm) {
            fsFields.forEach(name => {
              cardForm.querySelector(`[name=${name}]`).value = fsOverlay.querySelector(`[name=${name}]`).value;
            });
            cardForm.querySelector('[name=body]').value = fsTextarea.value;
            cardForm.dataset.frontmatter = fsOverlay.dataset.frontmatter;
            const cardPreviewPane = cardForm.querySelector('.preview-pane');
            if (cardPreviewPane) cardPreviewPane.innerHTML = marked.parse(fsTextarea.value);
          }
        }
      }

      fsOverlay.classList.remove('open');
    }

    document.querySelectorAll('.btn-fs-trigger').forEach(btn => {
      btn.addEventListener('click', () => openFullscreen(btn.dataset.slug));
    });

    document.getElementById('fs-close-btn').addEventListener('click', closeFullscreen);

    document.addEventListener('keydown', e => {
      // ESC 關閉全螢幕
      if (e.key === 'Escape' && fsOverlay.classList.contains('open')) {
        closeFullscreen();
        return;
      }
      // Ctrl+Shift+F / Cmd+Shift+F 開啟全螢幕
      if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key.toLowerCase() === 'f') {
        if (fsOverlay.classList.contains('open')) return;
        const openPanels = document.querySelectorAll('.edit-panel.open');
        if (openPanels.length === 1) {
          e.preventDefault();
          const form = openPanels[0].querySelector('.edit-form.ready');
          if (form) openFullscreen(form.dataset.slug);
        }
      }
    });

    // 同步捲動
    let fsSyncing = false;
    fsTextarea.addEventListener('scroll', () => {
      if (fsSyncing) return;
      fsSyncing = true;
      const pct = fsTextarea.scrollTop / (fsTextarea.scrollHeight - fsTextarea.clientHeight) || 0;
      fsPreview.scrollTop = pct * (fsPreview.scrollHeight - fsPreview.clientHeight);
      fsSyncing = false;
    });
    fsPreview.addEventListener('scroll', () => {
      if (fsSyncing) return;
      fsSyncing = true;
      const pct = fsPreview.scrollTop / (fsPreview.scrollHeight - fsPreview.clientHeight) || 0;
      fsTextarea.scrollTop = pct * (fsTextarea.scrollHeight - fsTextarea.clientHeight);
      fsSyncing = false;
    });

    // 即時預覽更新
    fsTextarea.addEventListener('input', () => {
      fsPreview.innerHTML = marked.parse(fsTextarea.value);
    });

    function syncOverlayToCardForm() {
      const slug = fsOverlay.dataset.slug;
      if (!slug) return null;
      const panel = document.getElementById(editId(slug));
      if (!panel) return null;
      const cardForm = panel.querySelector('.edit-form');
      if (!cardForm) return null;
      fsFields.forEach(name => {
        cardForm.querySelector(`[name=${name}]`).value = fsOverlay.querySelector(`[name=${name}]`).value;
      });
      cardForm.querySelector('[name=body]').value = fsTextarea.value;
      cardForm.dataset.frontmatter = fsOverlay.dataset.frontmatter;
      return cardForm;
    }

    document.getElementById('fs-btn-save').addEventListener('click', async () => {
      const cardForm = syncOverlayToCardForm();
      if (!cardForm) return;
      const fsBtns = [document.getElementById('fs-btn-save'), document.getElementById('fs-btn-publish')];
      fsBtns.forEach(b => { b.disabled = true; });
      await submitEdit(cardForm, false);
      fsBtns.forEach(b => { b.disabled = false; });
    });

    document.getElementById('fs-btn-publish').addEventListener('click', async () => {
      const slug = fsOverlay.dataset.slug;
      const cardForm = syncOverlayToCardForm();
      if (!cardForm) return;
      const fsBtns = [document.getElementById('fs-btn-save'), document.getElementById('fs-btn-publish')];
      fsBtns.forEach(b => { b.disabled = true; });
      await submitEdit(cardForm, true);
      fsBtns.forEach(b => { b.disabled = false; });
      // submitEdit 在發布成功後移除 card；若 card 已移除，closeFullscreen 會跳過 copy-back
      if (!document.getElementById(cardId(slug))) closeFullscreen();
    });

    document.querySelectorAll('.btn-edit').forEach(btn => {
      btn.addEventListener('click', async () => {
        const slug = btn.dataset.slug;
        const panel = document.getElementById(editId(slug));
        const isOpen = panel.classList.contains('open');

        if (isOpen) {
          panel.classList.remove('open');
          btn.classList.remove('active');
          btn.textContent = '編輯 ▾';
          return;
        }

        panel.classList.add('open');
        btn.classList.add('active');
        btn.textContent = '收起 ▴';

        const form = panel.querySelector('.edit-form');
        if (form.classList.contains('ready')) return;

        try {
          const res = await fetch(`/api/admin/raw?slug=${encodeURIComponent(slug)}&token=${token}`);
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);

          const fm = data.frontmatter;
          form.querySelector('[name=title]').value = fm.title ?? '';
          form.querySelector('[name=tldr]').value = fm.tldr ?? '';
          form.querySelector('[name=description]').value = fm.description ?? '';
          form.querySelector('[name=category]').value = fm.category ?? 'tech';
          form.querySelector('[name=tags]').value = Array.isArray(fm.tags) ? fm.tags.join(', ') : (fm.tags ?? '');
          const bodyTextarea = form.querySelector('[name=body]');
          bodyTextarea.value = data.body;
          form.dataset.frontmatter = JSON.stringify(fm);

          panel.querySelector('.edit-loading').style.display = 'none';
          form.classList.add('ready');

          const previewPane = form.querySelector('.preview-pane');
          const updatePreview = () => { previewPane.innerHTML = marked.parse(bodyTextarea.value); };
          updatePreview();
          bodyTextarea.addEventListener('input', updatePreview);
        } catch (err) {
          panel.querySelector('.edit-loading').textContent = `❌ 載入失敗：${err.message}`;
        }
      });
    });

    async function submitEdit(form, publishNow) {
      const slug = form.dataset.slug;
      const fm = JSON.parse(form.dataset.frontmatter ?? '{}');

      fm.title = form.querySelector('[name=title]').value.trim();
      fm.tldr = form.querySelector('[name=tldr]').value.trim();
      fm.description = form.querySelector('[name=description]').value.trim();
      fm.category = form.querySelector('[name=category]').value;
      fm.tags = form.querySelector('[name=tags]').value
        .split(',').map(t => t.trim()).filter(Boolean);
      fm.draft = !publishNow;

      const body = form.querySelector('[name=body]').value;
      const saveBtns = form.querySelectorAll('button');
      saveBtns.forEach(b => { b.disabled = true; });

      try {
        const res = await fetch(`/api/admin/save?token=${token}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, frontmatter: fm, body }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);

        const sha = data.commitSha.slice(0, 7);

        if (publishNow) {
          document.getElementById(cardId(slug))?.remove();
          showToast(
            `✅ 已發布 <strong>${fm.title}</strong>（${sha}）— <a href="${data.actionsUrl}" target="_blank">查看部署 →</a>`,
            'success', 8000
          );
          const remaining = document.querySelectorAll('#draft-list .card').length;
          document.getElementById('meta').textContent = `${remaining} 篇待審閱`;
          if (remaining === 0) {
            document.getElementById('draft-list').innerHTML = '<div class="empty">🎉 沒有待審閱的文章</div>';
          }
        } else {
          showToast(`💾 草稿已儲存（${sha}）`, 'success', 4000);
          form.dataset.frontmatter = JSON.stringify(fm);
          saveBtns.forEach(b => { b.disabled = false; });
        }
      } catch (err) {
        showToast(`❌ 儲存失敗：${err.message}`, 'error');
        saveBtns.forEach(b => { b.disabled = false; });
      }
    }

    document.querySelectorAll('.btn-save-draft').forEach(btn => {
      btn.addEventListener('click', () => submitEdit(btn.closest('form'), false));
    });
    document.querySelectorAll('.btn-publish-edit').forEach(btn => {
      btn.addEventListener('click', () => submitEdit(btn.closest('form'), true));
    });

    document.querySelectorAll('.btn-delete').forEach(btn => {
      btn.addEventListener('click', async () => {
        const slug = btn.dataset.slug;
        const title = btn.dataset.title;
        if (!confirm(`確定要刪除「${title}」？\n文章會移至 _trash/ 目錄，可從 git 復原。`)) return;
        btn.disabled = true;
        btn.textContent = '刪除中…';
        try {
          const res = await fetch(`/api/admin/delete?token=${token}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);
          document.getElementById(cardId(slug))?.remove();
          showToast(`🗑 已移至垃圾桶：${title}`, 'success', 4000);
          const remaining = document.querySelectorAll('#draft-list .card').length;
          document.getElementById('meta').textContent = `${remaining} 篇待審閱`;
          if (remaining === 0) {
            document.getElementById('draft-list').innerHTML = '<div class="empty">🎉 沒有待審閱的文章</div>';
          }
        } catch (err) {
          showToast(`❌ 刪除失敗：${err.message}`, 'error');
          btn.disabled = false;
          btn.textContent = '刪除';
        }
      });
    });

    document.querySelectorAll('.card-actions .btn-publish').forEach(btn => {
      btn.addEventListener('click', async () => {
        const slug = btn.dataset.slug;
        const title = btn.dataset.title;
        btn.disabled = true;
        btn.textContent = '發布中…';

        try {
          const res = await fetch(`/api/admin/publish?token=${token}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);

          document.getElementById(cardId(slug))?.remove();
          const sha = data.commitSha.slice(0, 7);
          showToast(
            `✅ 已發布 <strong>${title}</strong>（${sha}）— <a href="${data.actionsUrl}" target="_blank">查看部署 →</a>`,
            'success', 8000
          );
          const remaining = document.querySelectorAll('#draft-list .card').length;
          document.getElementById('meta').textContent = `${remaining} 篇待審閱`;
          if (remaining === 0) {
            document.getElementById('draft-list').innerHTML = '<div class="empty">🎉 沒有待審閱的文章</div>';
          }
        } catch (err) {
          showToast(`❌ 發布失敗：${err.message}`, 'error');
          btn.disabled = false;
          btn.textContent = '發布';
        }
      });
    });
  </script>
</body>
</html>

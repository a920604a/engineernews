---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

export const prerender = true;

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.lang === 'zh-TW');

  const categories = new Set<string>();
  allPosts.forEach((p) => categories.add(p.data.category));

  return Array.from(categories).map((category) => {
    const posts = allPosts
      .filter((p) => p.data.category === category)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return { params: { category }, props: { posts } };
  });
}

const { category } = Astro.params;
const { posts } = Astro.props;

const types = [...new Set(posts.flatMap((p) => p.data.type ? [p.data.type] : []))];
const typeLabels: Record<string, string> = {
  'debug': '除錯',
  'deep-dive': '深度解析',
  'guide': '指南',
  'how-to': '操作教學',
  'listicle': '清單整理',
  'explainer': '概念解析',
  'case-study': '案例分析',
  'comparison': '比較評測',
  'research': '研究筆記',
  'newsjacking': '時事觀察',
};
const topicMeta: Record<string, string> = {
  tech: '工程實作、架構設計、工具介紹與踩坑紀錄。',
  product: '產品設計、UX、功能策略與 side project 思考。',
  learning: 'AI、教育、課程、知識整理與概念拆解。',
  creative: '電影、動漫、設計、咖啡、旅遊與生活靈感。',
  career: '職涯選擇、工作方式、溝通與個人反思。',
  life: '日常紀錄、狀態整理與低頻但重要的觀察。',
};
const featured = posts.find(p => p.data.pinned) ?? null;
const rest = featured ? posts.filter(p => p.id !== featured.id) : posts;

function calcReadingTime(post: (typeof posts)[0]): number {
  if (post.data.readingTime) return post.data.readingTime;
  const body = post.body ?? '';
  const chars = body.replace(/\s+/g, '').length;
  return Math.max(1, Math.round(chars / 300));
}
---

<BaseLayout title={`分類：${category}`}>
  <section class="topic-page" style={`--cat-color: var(--cat-${category}, var(--cat-default, var(--accent)));`}>
    <a href="/categories" class="back-link">
      ← 所有分類
    </a>
    <div class="topic-hero">
      <span class="badge badge-category" data-category={category}>{category}</span>
      <h1>{category}</h1>
      <p>{topicMeta[category] ?? '相關文章與作品整理。'}</p>
      <span class="topic-stat">{posts.length} 篇文章</span>
    </div>

    <div class="controls-row">
      {types.length > 0 && (
        <div class="control-group" id="type-filters">
          <span class="control-label">類型</span>
          <button class="type-btn active" data-type="all">全部</button>
          {types.map((type) => (
            <button class="type-btn" data-type={type}>
              {typeLabels[type] ?? type}
            </button>
          ))}
        </div>
      )}

      <div class="control-group" id="sort-controls">
        <span class="control-label">排序</span>
        <button class="sort-btn active" data-sort="date-desc">日期 ↓</button>
        <button class="sort-btn" data-sort="date-asc">日期 ↑</button>
        <button class="sort-btn" data-sort="reading-time">閱讀時間</button>
        <button class="sort-btn" data-sort="tags">標籤 A→Z</button>
        <button class="sort-btn" data-sort="views" id="sort-views-btn">瀏覽次數</button>
      </div>
    </div>

    {featured && (
      <section class="featured">
        <p class="section-label">代表文章</p>
        <PostCard
          id={featured.id}
          title={featured.data.title}
          date={featured.data.date}
          category={featured.data.category}
          tags={featured.data.tags}
          description={featured.data.description}
          tldr={featured.data.tldr}
          type={featured.data.type}
          readingTime={featured.data.readingTime}
          lang="zh-TW"
          featured={true}
        />
      </section>
    )}

    <div class="feed" id="posts-feed">
      {rest.map((post) => (
        <div
          data-type={post.data.type ?? 'none'}
          data-date={post.data.date.valueOf()}
          data-reading-time={calcReadingTime(post)}
          data-tags={post.data.tags?.[0] ?? ''}
          data-slug={post.id}
          data-views="0"
          class="post-item"
        >
          <PostCard
            id={post.id}
            title={post.data.title}
            date={post.data.date}
            category={post.data.category}
            tags={post.data.tags}
            description={post.data.description}
            tldr={post.data.tldr}
            type={post.data.type}
            readingTime={post.data.readingTime}
            lang="zh-TW"
          />
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .controls-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 24px;
  }
  .control-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .control-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--label-tertiary);
    min-width: 32px;
  }
  .type-btn, .sort-btn {
    padding: 5px 14px;
    border-radius: 999px;
    border: 0.5px solid var(--separator);
    background: transparent;
    color: var(--label-secondary);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }
  .type-btn:hover, .type-btn.active {
    background: var(--cat-color);
    border-color: var(--cat-color);
    color: #fff;
  }
  .sort-btn:hover, .sort-btn.active {
    background: var(--bg-tertiary, var(--bg-secondary));
    border-color: var(--label-secondary);
    color: var(--label);
  }
  .sort-btn[data-sort="views"].loading {
    opacity: 0.5;
    cursor: wait;
  }
  .topic-page {
    padding-top: 32px;
  }
  .back-link {
    font-size: 13px;
    color: var(--label-secondary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 18px;
  }
  .back-link:hover { color: var(--cat-color); }
  .topic-hero {
    padding: 24px 0 28px;
    border-bottom: 0.5px solid color-mix(in srgb, var(--cat-color) 28%, var(--separator));
    margin-bottom: 24px;
  }
  .topic-hero h1 {
    margin: 12px 0 10px;
    font-size: clamp(32px, 7vw, 52px);
  }
  .topic-hero p {
    max-width: 660px;
    margin: 0;
    color: var(--label-secondary);
    line-height: 1.75;
  }
  .topic-stat {
    display: inline-flex;
    margin-top: 16px;
    color: var(--cat-color);
    font-size: 13px;
    font-weight: 800;
  }
  .featured {
    margin-bottom: 24px;
  }
  .section-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--label-tertiary);
    margin: 0 0 10px;
  }
  .feed {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
</style>

<script>
  let activeFilter = 'all';
  let activeSort = 'date-desc';
  let viewsLoaded = false;

  function filterPosts(type: string) {
    activeFilter = type;
    const items = document.querySelectorAll<HTMLElement>('.post-item');
    items.forEach((item) => {
      item.style.display = (type === 'all' || item.dataset.type === type) ? '' : 'none';
    });
    document.querySelectorAll<HTMLElement>('.type-btn').forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.type === type);
    });
  }

  function sortPosts(key: string) {
    activeSort = key;
    document.querySelectorAll<HTMLElement>('.sort-btn').forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.sort === key);
    });

    const feed = document.getElementById('posts-feed');
    if (!feed) return;
    const items = Array.from(feed.querySelectorAll<HTMLElement>('.post-item'));

    items.sort((a, b) => {
      switch (key) {
        case 'date-asc':
          return Number(a.dataset.date) - Number(b.dataset.date);
        case 'date-desc':
          return Number(b.dataset.date) - Number(a.dataset.date);
        case 'reading-time':
          return Number(a.dataset.readingTime) - Number(b.dataset.readingTime);
        case 'tags':
          return (a.dataset.tags ?? '').localeCompare(b.dataset.tags ?? '', 'zh-TW');
        case 'views':
          return Number(b.dataset.views) - Number(a.dataset.views);
        default:
          return 0;
      }
    });

    items.forEach((item) => feed.appendChild(item));
  }

  // Attach type filter button handlers
  document.querySelectorAll<HTMLElement>('.type-btn').forEach((btn) => {
    btn.addEventListener('click', () => filterPosts(btn.dataset.type!));
  });

  // Attach sort button handlers
  document.querySelectorAll<HTMLElement>('.sort-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.dataset.sort!;
      if (key === 'views' && !viewsLoaded) {
        loadViews().then(() => sortPosts(key));
      } else {
        sortPosts(key);
      }
    });
  });

  async function loadViews() {
    const btn = document.getElementById('sort-views-btn');
    if (btn) btn.classList.add('loading');

    const items = document.querySelectorAll<HTMLElement>('.post-item[data-slug]');
    await Promise.all(Array.from(items).map(async (item) => {
      const slug = item.dataset.slug;
      if (!slug) return;
      try {
        const res = await fetch(`/api/views?slug=${encodeURIComponent(slug)}`);
        const { count } = await res.json();
        item.dataset.views = String(count ?? 0);
      } catch {
        // 靜默失敗
      }
    }));

    viewsLoaded = true;
    if (btn) btn.classList.remove('loading');
  }

  // support ?type= query param
  const params = new URLSearchParams(window.location.search);
  const t = params.get('type');
  if (t) filterPosts(t);
</script>

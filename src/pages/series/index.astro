---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';
import { getSeriesSummaries, getSeriesHref } from '../../utils/series';

const lang = 'zh-TW';
const t = useTranslations(lang);
const seriesList = await getSeriesSummaries(lang);
---
<BaseLayout title={t('series.title')} description={t('series.subtitle')}>
  <header class="page-head">
    <h1>{t('series.title')}</h1>
    <p>{t('series.subtitle')}</p>
  </header>

  {seriesList.length === 0 ? (
    <p class="empty">{t('series.empty')}</p>
  ) : (
    <div class="series-grid">
      {seriesList.map(series => (
        <a href={getSeriesHref(series.name, lang)} class="series-card">
          <div class="series-meta">
            <span class="series-count">{series.count} {t('series.posts')}</span>
            <span class="series-date">{series.latestDate.toLocaleDateString('zh-TW')}</span>
          </div>
          <h2>{series.name}</h2>
          <p>{series.description}</p>
        </a>
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .page-head { margin: 32px 0 28px; }
  .page-head h1 { font-size: 28px; font-weight: 700; margin: 0 0 6px; }
  .page-head p { color: var(--label-secondary); margin: 0; font-size: 15px; }

  .series-grid { display: grid; gap: 14px; }
  .series-card {
    display: block;
    border: 0.5px solid var(--separator);
    border-radius: var(--radius-md);
    padding: 18px 20px;
    background: var(--card-bg);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s;
  }
  .series-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .series-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 12px;
    color: var(--label-tertiary);
    margin-bottom: 8px;
  }
  .series-card h2 { margin: 0 0 6px; font-size: 18px; color: var(--label); }
  .series-card p { margin: 0; color: var(--label-secondary); font-size: 14px; line-height: 1.7; }
  .empty { color: var(--label-tertiary); margin-top: 24px; }
</style>

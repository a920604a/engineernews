---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.lang === 'zh-TW');
  const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags))].filter((tag) => tag && tag.trim() !== '');

  return uniqueTags.map((tag) => {
    const filtered = allPosts
      .filter((post) => post.data.tags.includes(tag))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
    return { params: { tag }, props: { posts: filtered } };
  });
}

const { tag } = Astro.params;
const { posts = [] } = Astro.props;

const relatedTags = [...new Set(posts.flatMap(p => p.data.tags))]
  .filter(t => t !== tag)
  .slice(0, 8);
---

<BaseLayout title={`#${tag}`}>
  <section class="tag-page">
    <a href="/" class="back-link">← 首頁</a>

    <div class="tag-hero">
      <p class="eyebrow">Tag</p>
      <h1><span class="tag-hash">#</span>{tag}</h1>
      <p class="tag-stat">{posts.length} 篇文章</p>
    </div>

    {relatedTags.length > 0 && (
      <div class="related-tags">
        <span class="related-label">相關標籤</span>
        {relatedTags.map(t => (
          <a href={`/tags/${t}`} class="related-tag">#{t}</a>
        ))}
      </div>
    )}

    <div class="feed">
      {posts.map((post) => (
        <PostCard
          id={post.id}
          title={post.data.title}
          date={post.data.date}
          category={post.data.category}
          tags={post.data.tags}
          description={post.data.description}
          tldr={post.data.tldr}
          type={post.data.type}
          readingTime={post.data.readingTime}
          github={post.data.github}
          url={post.data.url}
          lang="zh-TW"
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .tag-page {
    padding-top: 32px;
  }
  .back-link {
    font-size: 13px;
    color: var(--label-secondary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 18px;
    transition: color 0.15s;
  }
  .back-link:hover { color: var(--accent); }

  .tag-hero {
    padding: 24px 0 28px;
    border-bottom: 0.5px solid var(--separator);
    margin-bottom: 24px;
  }
  .eyebrow {
    color: var(--heading-accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 10px;
  }
  .tag-hero h1 {
    font-size: clamp(32px, 7vw, 52px);
    margin: 0 0 12px;
    line-height: 1.1;
  }
  .tag-hash {
    color: var(--accent);
    opacity: 0.6;
  }
  .tag-stat {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
  }

  .related-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }
  .related-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--label-tertiary);
    margin-right: 4px;
  }
  .related-tag {
    font-size: 12px;
    color: var(--label-secondary);
    text-decoration: none;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    border: 0.5px solid var(--separator);
    background: var(--bg-secondary);
    transition: color 0.15s, border-color 0.15s;
  }
  .related-tag:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--separator));
  }

  .feed {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
</style>

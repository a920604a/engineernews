---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SharePanel from '../../components/SharePanel.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import PostPrevNext from '../../components/PostPrevNext.astro';
import { useTranslations } from '../../i18n/utils';
import { TTSPlayer } from '../../components/TTSPlayer';
import { AskThisPost } from '../../components/AskThisPost';
import { PostFaq } from '../../components/PostFaq';
import { InteractionBar } from '../../components/InteractionBar';
import { CommentSection } from '../../components/CommentSection';
import { getRelatedPosts } from '../../utils/relatedPosts';
import { getSeriesNav } from '../../utils/seriesNav';
import { calcReadingTime } from '../../utils/readingTime';
import { getOgImageUrl } from '../../lib/shareCard';
import { getPostUrl } from '../../lib/postPaths';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft && data.lang === 'zh-TW');
  const allPosts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post, allPosts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const t = useTranslations('zh-TW');
const related = getRelatedPosts(post, allPosts);
const series = getSeriesNav(post, allPosts);
const readingTime = post.data.readingTime ?? calcReadingTime(post.body ?? '');
const ogImage = getOgImageUrl(Astro.url.pathname, Astro.url.origin) ?? undefined;

// Calculate Prev/Next
const sortedPosts = allPosts
  .filter(p => !p.data.draft && p.data.lang === 'zh-TW')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const currentIndex = sortedPosts.findIndex(p => p.id === post.id);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : undefined;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": post.data.title,
  "description": post.data.description ?? post.data.tldr,
  "datePublished": post.data.date.toISOString(),
  "keywords": post.data.tags.join(", "),
};

const dateStr = post.data.date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={post.data.title} description={post.data.description} jsonLd={jsonLd} layout="article" ogImage={ogImage} postId={post.id} postTitle={post.data.title}>
  <!-- Full-bleed Hero Banner -->
  <header class="post-hero" data-category={post.data.category} style={`--cat-color: var(--cat-${post.data.category}, var(--cat-default, var(--accent)));`}>
    <!-- OG Background Layer -->
    <div class="hero-bg-wrapper">
      {ogImage && (
        <img 
          src={ogImage} 
          alt="" 
          class="hero-bg-img"
          onerror="this.style.display='none'"
        />
      )}
      <div class="hero-bg-overlay"></div>
    </div>

    <div class="hero-inner">
      <div class="hero-content">
        <div class="hero-meta">
          <a href={`/categories/${post.data.category}`} class="hero-badge badge-category" data-category={post.data.category}>{post.data.category}</a>
          <time class="hero-date">{dateStr}</time>
          <span class="hero-sep">·</span>
          <span class="hero-reading">{readingTime} 分鐘閱讀</span>
          <span class="hero-sep">·</span>
          <span id="view-count" class="hero-views">－ 次閱讀</span>
        </div>

        <h1 class="hero-title">{post.data.title}</h1>

        {post.data.tldr && (
          <div class="hero-tldr">
            <p class="tldr-label">{t('post.tldr')}</p>
            <p class="tldr-content">{post.data.tldr}</p>
          </div>
        )}
      </div>
    </div>

    <!-- Wave Separator -->
    <div class="hero-wave">
      <svg data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" class="shape-fill"></path>
      </svg>
    </div>
  </header>

  <div class="article-grid">
  <article class="article-body">
    <!-- Series nav (top) -->
    {series && (
      <div style="background:var(--bg-secondary); border:0.5px solid var(--separator); border-radius:var(--radius-md); padding:14px 18px; margin-bottom:28px; font-size:13px;">
        <p style="margin:0 0 8px; font-weight:600; color:var(--label-secondary); text-transform:uppercase; letter-spacing:0.05em; font-size:11px;">
          系列：{series.name}（{series.current}/{series.total}）
        </p>
        <div style="display:flex; justify-content:space-between; gap:12px;">
          {series.prev
            ? <a href={getPostUrl(series.prev.id, 'zh-TW')} style="color:var(--accent); text-decoration:none; font-size:13px;">← {series.prev.title}</a>
            : <span />}
          {series.next && <a href={getPostUrl(series.next.id, 'zh-TW')} style="color:var(--accent); text-decoration:none; font-size:13px;">{series.next.title} →</a>}
        </div>
      </div>
    )}

    <!-- 重點速覽（給沒耐心逐字讀的讀者：10 秒掃完） -->
    {post.data.key_points && post.data.key_points.length > 0 && (
      <div class="key-points">
        <div class="kp-header">
          <span class="kp-label">重點速覽</span>
          <span class="kp-reading">{readingTime} 分鐘閱讀</span>
        </div>
        <ul class="kp-list">
          {post.data.key_points.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    )}

    <!-- Table of Contents -->
    {tocHeadings.length > 2 && (
      <details class="toc-block toc-mobile" open>
        <summary>目錄</summary>
        <nav>
          <ol>
            {tocHeadings.map(h => (
              <li style={h.depth === 3 ? 'margin-left:1.2em;' : ''}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </details>
    )}

    <!-- Content -->
    <div class="prose"><Content /></div>
    <div id="article-end-sentinel"></div>

    <!-- 讀者常問（admin 已核定的 Q&A，client-side fetch，沒有審核過就不 render） -->
    <PostFaq client:visible postId={post.id} lang="zh-TW" />

    <!-- 問這篇（讀完不想全找答案時，直接問本文） -->
    <AskThisPost client:visible postId={post.id} lang="zh-TW" />

    <!-- Prev/Next Nav -->
    <PostPrevNext 
      prev={prevPost ? { id: prevPost.id, title: prevPost.data.title } : undefined} 
      next={nextPost ? { id: nextPost.id, title: nextPost.data.title } : undefined} 
    />

    <!-- Share (mobile: above tags; hidden on desktop) -->
    <div class="article-share-panel">
      <SharePanel title={post.data.title} url={Astro.url.href} imageUrl={ogImage ?? ''} />
    </div>

    <!-- Interactions -->
    <InteractionBar client:visible slug={post.id} />
    <CommentSection client:visible slug={post.id} />

    <!-- Tags -->
    {post.data.tags.length > 0 && (
      <div style="margin-top:32px; padding-top:24px; border-top:0.5px solid var(--separator);">
        <p style="font-size:11px; color:var(--label-tertiary); margin:0 0 10px; text-transform:uppercase; letter-spacing:0.05em; font-weight:600;">{t('post.tags')}</p>
        <div class="tags">
          {post.data.tags.map((tag) => (
            <a href={`/tags/${tag}`} class="tag">#{tag}</a>
          ))}
        </div>
      </div>
    )}

    <!-- Related posts -->
    {related.length > 0 && (
      <div style="margin-top:48px; padding-top:32px; border-top:0.5px solid var(--separator);">
        <h3 style="font-size:13px; color:var(--label-secondary); margin:0 0 16px; text-transform:uppercase; letter-spacing:0.05em; font-weight:600;">相關文章</h3>
        <div class="feed">
          {related.map((p) => (
            <PostCard
              id={p.id}
              title={p.data.title}
              date={p.data.date}
              category={p.data.category}
              tags={p.data.tags}
              tldr={p.data.tldr}
              description={p.data.description}
              lang="zh-TW"
            />
          ))}
        </div>
      </div>
    )}
  </article>

  <aside class="article-toc-sidebar">
    <!-- TTS Player (desktop sidebar, full) -->
    <TTSPlayer
      client:load
      title={post.data.title}
      tldr={post.data.tldr}
      content={post.body ?? ''}
      initialAudioUrl={post.data.audio_url}
      initialSrtUrl={post.data.srt_url}
    />

    {tocHeadings.length > 2 && (
      <div class="sidebar-block">
        <p class="toc-sidebar-title">目錄</p>
        <ol>
          {tocHeadings.map(h => (
            <li class={h.depth === 3 ? 'toc-item toc-item--sub' : 'toc-item'}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </div>
    )}
  </aside>
  </div>

  <!-- TTS Mini Bar (mobile fixed bottom) -->
  <TTSPlayer
    client:load
    title={post.data.title}
    tldr={post.data.tldr}
    content={post.body ?? ''}
    initialAudioUrl={post.data.audio_url}
    initialSrtUrl={post.data.srt_url}
    compact={true}
  />
</BaseLayout>

<style>
  .post-hero {
    position: relative;
    padding: 100px 24px 120px;
    background: var(--bg);
    overflow: hidden;
    margin-bottom: 40px;
    border-bottom: 0.5px solid var(--separator);
  }

  .hero-bg-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .hero-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(60px) saturate(1.8);
    opacity: 0.45;
    transform: scale(1.1);
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg, 
      color-mix(in srgb, var(--cat-color) 15%, transparent) 0%, 
      var(--bg) 100%
    );
  }

  .hero-inner {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .hero-badge {
    background: var(--cat-color);
    color: #fff;
    padding: 2px 10px;
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .hero-date, .hero-reading, .hero-views {
    font-size: 13px;
    color: var(--label-secondary);
    font-variant-numeric: tabular-nums;
  }

  .hero-sep {
    color: var(--label-tertiary);
    opacity: 0.5;
  }

  .hero-title {
    font-size: clamp(28px, 6vw, 44px);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 24px;
    color: var(--label);
  }

  .hero-tldr {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(10px);
    border: 0.5px solid rgba(255, 255, 255, 0.1);
    border-left: 4px solid var(--cat-color);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    max-width: 680px;
  }

  .tldr-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--cat-color);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 8px;
  }

  .tldr-content {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--label-secondary);
  }

  .hero-wave {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    transform: rotate(180deg);
  }

  .hero-wave svg {
    position: relative;
    display: block;
    width: calc(100% + 1.3px);
    height: 48px;
  }

  .hero-wave .shape-fill {
    fill: var(--bg);
  }

  .article-grid { display: block; }

  .article-body {
    max-width: 720px;
    margin: 0 auto;
  }

  .article-share-panel {
    display: block;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 0.5px solid var(--separator);
  }

  /* ── 重點速覽 ── */
  .key-points {
    background: var(--bg-secondary);
    border: 0.5px solid var(--separator);
    border-left: 4px solid var(--cat-color, var(--accent));
    border-radius: var(--radius-md);
    padding: 16px 20px;
    margin-bottom: 28px;
  }
  .kp-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .kp-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cat-color, var(--accent));
  }
  .kp-reading {
    font-size: 12px;
    font-weight: 600;
    color: var(--label-tertiary);
    font-variant-numeric: tabular-nums;
  }
  .kp-list {
    margin: 0;
    padding-left: 1.2em;
    list-style: none;
  }
  .kp-list li {
    position: relative;
    font-size: 15px;
    line-height: 1.6;
    color: var(--label);
    margin: 0 0 8px;
    padding-left: 4px;
  }
  .kp-list li:last-child { margin-bottom: 0; }
  .kp-list li::before {
    content: '';
    position: absolute;
    left: -0.9em;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cat-color, var(--accent));
  }

  @media (min-width: 1140px) {
    .article-grid {
      display: grid;
      /* minmax(0, …) lets the content column shrink below its intrinsic width;
         without it a wide code block/table blows the grid past its max-width and
         pushes the TOC/導讀 sidebar off-screen (horizontal scroll on 13" laptops). */
      grid-template-columns: minmax(0, 1fr) 240px;
      gap: 56px;
      align-items: start;
      max-width: 1100px;
      margin: 0 auto;
    }
    .article-body {
      max-width: none;
      margin: 0;
      min-width: 0;
    }
    .toc-mobile { display: none; }
  }

  .article-toc-sidebar { display: none; }

  /* leave room for mobile mini bar */
  @media (max-width: 1139px) {
    .article-body { padding-bottom: 72px; }
  }

  @media (min-width: 1140px) {
    .article-toc-sidebar {
      display: flex;
      flex-direction: column;
      gap: 16px;
      position: sticky;
      top: 110px;
      max-height: calc(100vh - 140px);
      overflow-y: auto;
      padding: 0;
      background: transparent;
      border: none;
    }
  }

  .sidebar-block {
    background: var(--bg-secondary);
    border: 0.5px solid var(--separator);
    border-radius: var(--radius-md);
    padding: 14px 16px;
  }

  .toc-sidebar-title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--label-secondary);
    margin: 0 0 10px;
  }

  .article-toc-sidebar ol { padding: 0; margin: 0; list-style: none; }
  .toc-item { position: relative; }
  .toc-item + .toc-item { margin-top: 8px; }
  .toc-item--sub { padding-left: 14px; }
  .toc-item--sub::before {
    content: '';
    position: absolute;
    left: 4px; top: 10px;
    width: 4px; height: 1px;
    background: var(--label-tertiary);
    opacity: 0.5;
  }

  .article-toc-sidebar a {
    color: var(--label-secondary);
    text-decoration: none;
    line-height: 1.4;
    transition: all 0.15s ease;
    display: block;
    font-size: 13px;
  }
  .article-toc-sidebar a:hover {
    color: var(--accent);
    transform: translateX(2px);
  }

  /* ── 術語標注（中文內文中的英文專業術語）── */
  .prose :global(.gloss) {
    border-bottom: 1px dashed var(--accent);
    cursor: help;
    position: relative;
    display: inline;
  }

  .prose :global(.gloss::after) {
    content: attr(data-def);
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--bg-secondary);
    border: 0.5px solid var(--separator);
    border-radius: var(--radius-sm);
    padding: 4px 8px;
    font-size: 12px;
    color: var(--label);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.15s;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  /* 觸控裝置沒有 hover，靠點擊卡片，不顯示 CSS tooltip 以免殘留 */
  @media (hover: hover) {
    .prose :global(.gloss:hover::after) {
      opacity: 1;
    }
  }

  /* 詞彙點擊卡片 */
  :global(.gloss-card) {
    position: fixed;
    z-index: 200;
    background: var(--bg-secondary);
    border: 0.5px solid var(--separator);
    border-radius: var(--radius-md);
    padding: 14px 16px;
    width: 320px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.22);
  }

  :global(.gloss-card-head) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }

  :global(.gloss-card-term) {
    font-size: 14px;
    font-weight: 700;
    color: var(--label);
    text-transform: capitalize;
  }

  :global(.gloss-card-levels) {
    display: inline-flex;
    border: 0.5px solid var(--separator);
    border-radius: var(--radius-full);
    padding: 2px;
    gap: 2px;
  }
  :global(.gloss-card-levels button) {
    font-size: 11px;
    padding: 2px 9px;
    border: none;
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--label-secondary);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  :global(.gloss-card-levels button.active) {
    background: var(--accent);
    color: #fff;
  }

  :global(.gloss-card-def) {
    font-size: 14px;
    line-height: 1.65;
    color: var(--label);
    margin: 0 0 8px;
  }

  :global(.gloss-card-context) {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--label-secondary);
    margin: 0 0 8px;
    padding-top: 8px;
    border-top: 0.5px solid var(--separator);
  }

  :global(.gloss-card-reading) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  :global(.gloss-card-reading a) {
    font-size: 12px;
    color: var(--accent);
    text-decoration: none;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: var(--glass);
  }
  :global(.gloss-card-reading a:hover) { text-decoration: underline; }
</style>

<script define:vars={{ slug: post.id, readingTime }}>
  (async () => {
    const MIN_SECONDS = Math.min(90, Math.max(20, Math.round(readingTime * 60 * 0.3)));
    let scrolledToEnd = false;
    let timeElapsed = false;
    let audioCompleted = false;
    let counted = false;

    function updateDisplay(count) {
      const el = document.getElementById('view-count');
      if (el && typeof count === 'number') el.textContent = `${count.toLocaleString()} 次閱讀`;
    }

    async function tryCount() {
      if (counted) return;
      // 完成一次閱讀的條件（擇一即可）：
      //   1. 捲到文末 + 停留足夠時間
      //   2. 聽完整個語音導讀 mp3
      if (!audioCompleted && (!scrolledToEnd || !timeElapsed)) return;
      counted = true;
      try {
        const res = await fetch('/api/views', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug }),
        });
        const { count } = await res.json();
        updateDisplay(count);
      } catch {}
    }

    // 頁面載入時先顯示目前計數
    try {
      const res = await fetch(`/api/views?slug=${encodeURIComponent(slug)}`);
      const { count } = await res.json();
      updateDisplay(count);
    } catch {}

    // 條件一：捲到文章底部
    const sentinel = document.getElementById('article-end-sentinel');
    if (sentinel) {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          scrolledToEnd = true;
          observer.disconnect();
          tryCount();
        }
      }, { threshold: 0.5 });
      observer.observe(sentinel);
    }

    // 條件二：停留 10 秒
    setTimeout(() => {
      timeElapsed = true;
      tryCount();
    }, MIN_SECONDS * 1000);

    // 條件三（獨立充分條件）：聽完整個語音導讀 mp3
    window.addEventListener('tts:ended', () => {
      audioCompleted = true;
      tryCount();
    });
  })();
</script>

<ScrollToTop />

<!-- 術語標注：掃描內文標出技術術語，點擊呼叫互動詞彙卡（AI 解釋 + 入門/進階切換 + 查詢統計） -->
<script type="application/json" id="glossary-data" set:html={JSON.stringify({ slug: post.id, lang: 'zh-TW', entries: post.data.glossary ?? [] })}></script>
<script>
  import { applyGlossary } from '../../lib/applyGlossary';

  type AnyEntry = { term: string; aliases?: string[]; [k: string]: unknown };
  type Explain = { definition?: string; context?: string; reading?: { label: string; url: string }[] };

  const dataEl = document.getElementById('glossary-data');
  const cfg = dataEl ? JSON.parse(dataEl.textContent || '{}') : {};
  const slug: string = cfg.slug || '';
  const lang: string = cfg.lang || 'zh-TW';
  const isEn = lang === 'en';
  const frontEntries: AnyEntry[] = Array.isArray(cfg.entries) ? cfg.entries : [];
  const frontMap = new Map<string, AnyEntry>();
  for (const e of frontEntries) {
    frontMap.set(String(e.term).toLowerCase(), e);
    for (const a of e.aliases || []) frontMap.set(String(a).toLowerCase(), e);
  }

  const prose = document.querySelector<HTMLElement>('.prose');
  if (prose) {
    applyGlossary(prose, frontEntries);

    let card: HTMLDivElement | null = null;
    const cache = new Map<string, Explain>();

    function closeCard() { card?.remove(); card = null; }

    async function fetchLevel(term: string, context: string, level: string, seed: AnyEntry | undefined): Promise<Explain> {
      const key = `${term}:${level}`;
      const hit = cache.get(key);
      if (hit) return hit;
      const res = await fetch('/api/glossary/explain', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ term, slug, lang, level, context, seed }),
      });
      const data = await res.json() as Explain;
      cache.set(key, data);
      return data;
    }

    function renderBody(bodyEl: HTMLElement, data: Explain) {
      bodyEl.innerHTML = '';
      const def = document.createElement('p');
      def.className = 'gloss-card-def';
      def.textContent = data.definition || '';
      bodyEl.appendChild(def);
      if (data.context) {
        const ctx = document.createElement('p');
        ctx.className = 'gloss-card-context';
        ctx.textContent = data.context;
        bodyEl.appendChild(ctx);
      }
      if (Array.isArray(data.reading) && data.reading.length) {
        const reading = document.createElement('div');
        reading.className = 'gloss-card-reading';
        for (const link of data.reading) {
          const a = document.createElement('a');
          a.href = link.url;
          a.textContent = link.label;
          reading.appendChild(a);
        }
        bodyEl.appendChild(reading);
      }
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const gloss = target.closest<HTMLElement>('.gloss');
      if (!gloss || !gloss.closest('.prose')) {
        if (!target.closest('.gloss-card')) closeCard();
        return;
      }
      e.stopPropagation();

      const term = gloss.dataset.term || gloss.textContent?.toLowerCase() || '';
      const quick = gloss.dataset.def || '';
      const context = (gloss.closest('p, li, blockquote, td')?.textContent || '').slice(0, 400);
      const seed = frontMap.get(term.toLowerCase());

      closeCard();
      const rect = gloss.getBoundingClientRect();
      card = document.createElement('div');
      card.className = 'gloss-card';
      card.style.left = `${Math.min(rect.left, window.innerWidth - 332)}px`;
      card.style.top = `${Math.min(rect.bottom + 8, window.innerHeight - 240)}px`;

      const head = document.createElement('div');
      head.className = 'gloss-card-head';
      const termEl = document.createElement('span');
      termEl.className = 'gloss-card-term';
      termEl.textContent = term;
      const toggle = document.createElement('div');
      toggle.className = 'gloss-card-levels';
      head.append(termEl, toggle);

      const bodyEl = document.createElement('div');
      bodyEl.className = 'gloss-card-body';
      const loading = document.createElement('p');
      loading.className = 'gloss-card-def';
      loading.textContent = quick || (isEn ? 'Loading…' : '載入中…');
      bodyEl.appendChild(loading);

      card.append(head, bodyEl);
      document.body.appendChild(card);

      const levels: [string, string][] = isEn
        ? [['beginner', 'Basic'], ['advanced', 'Deep']]
        : [['beginner', '入門'], ['advanced', '進階']];
      const btns: Record<string, HTMLButtonElement> = {};
      const myCard = card;

      async function selectLevel(level: string) {
        for (const k in btns) btns[k].classList.toggle('active', k === level);
        const data = await fetchLevel(term, context, level, seed);
        if (card === myCard) renderBody(bodyEl, data);
      }
      for (const [level, label] of levels) {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        b.addEventListener('click', (ev) => { ev.stopPropagation(); selectLevel(level); });
        btns[level] = b;
        toggle.appendChild(b);
      }
      selectLevel('beginner');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeCard();
    });
  }
</script>
